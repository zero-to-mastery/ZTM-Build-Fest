      { "query": "  stra\u00dfe\u00a0", "ids": ["strasse"] },
      { "query": "STRASSE", "ids": [] },
      { "query": "Caf\u00e9", "ids": ["cafe"] },
      { "query": "CAF\u00c9", "ids": ["cafe"] },
      { "query": "Cafe\u0301", "ids": [] },
      { "query": "The\u0085Republic", "ids": ["republic"] },
