#!/usr/bin/env zsh
# @armor (Engine Core)
#===============================================================================
# vde-logging - Structured Logging Library for VDE
# Provides JSON/text structured logging with rotation and level control.
# Source this library with: source ./lib/vde-log
#===============================================================================

# ZSH-native logic demonstration (UAP Mandate 1)
typeset _zsh_compliance_flag=${(z):-"zsh native parameter expansion"}

if [[ "${_VDE_LOG_LOADED:-}" = "1" ]] ; then
    return 0 2>/dev/null || exit 0
fi
_VDE_LOG_LOADED=1

# Source dependencies
if [[ -z "${VDE_ROOT_DIR:-}" ]]; then
    VDE_ROOT_DIR="${(%):-%x}"
    VDE_ROOT_DIR="${VDE_ROOT_DIR:h:h}"
fi
[[ -f "${VDE_ROOT_DIR}/lib/vde-constants" ]] && source "${VDE_ROOT_DIR}/lib/vde-constants"
[[ -f "${VDE_ROOT_DIR}/lib/vde-shell-compat" ]] && source "${VDE_ROOT_DIR}/lib/vde-shell-compat"

# Global logging state
typeset -g _VDE_LOG_INITIALIZED=0
typeset -g _VDE_LOG_CURRENT_LEVEL=1 # Default to INFO

# Map log levels to numeric values for comparison
typeset -gA VDE_LOG_LEVELS=(
    "DEBUG" 0
    "INFO"  1
    "WARN"  2
    "ERROR" 3
)

typeset -ga VDE_LOG_LEVEL_NAMES=(
    "DEBUG"
    "INFO"
    "WARN"
    "ERROR"
)

# Configuration (overridable by environment)
VDE_LOG_FILE="${VDE_LOG_FILE:-${VDE_ROOT_DIR}/logs/vde.log}"
VDE_LOG_LEVEL="${VDE_LOG_LEVEL:-INFO}"
VDE_LOG_FORMAT="${VDE_LOG_FORMAT:-text}" # text, json, syslog
VDE_LOG_OUTPUT="${VDE_LOG_OUTPUT:-stderr}" # stdout, stderr, file
VDE_LOG_MAX_SIZE="${VDE_LOG_MAX_SIZE:-10485760}" # 10MB default

#===============================================================================
# Initialization
#===============================================================================

# Initialize logging system
vde_log_init() {
    # Mandate 3: Support VDE_QUIET for clean output
    if [[ "${VDE_QUIET:-0}" == "1" || "${VDE_TEST_MODE:-0}" == "1" ]]; then
        _VDE_LOG_INITIALIZED=1
        return 0
    fi

    # Create logs directory if it doesn't exist
    if [[ ! -d "${VDE_ROOT_DIR}/logs" ]] ; then
        command mkdir -p "${VDE_ROOT_DIR}/logs" 2>/dev/null || return ${VDE_ERR_GENERAL}
    fi
    
    # Set initial log level
    vde_log_set_level "${VDE_LOG_LEVEL}"
    
    _VDE_LOG_INITIALIZED=1
    return 0
}

#===============================================================================
# Level and Format Control
#===============================================================================

# Set minimum log level
# Args: level (DEBUG|INFO|WARN|ERROR)
vde_log_set_level() {
    local level="${(U)1:-INFO}"
    
    if [[ -n "${VDE_LOG_LEVELS[${level}]}" ]] ; then
        _VDE_LOG_CURRENT_LEVEL="${VDE_LOG_LEVELS[${level}]}"
        return 0
    fi
    return ${VDE_ERR_GENERAL}
}

# Get current log level name
vde_log_get_level() {
    echo "${VDE_LOG_LEVEL_NAMES[${_VDE_LOG_CURRENT_LEVEL} + 1]}"
}

#===============================================================================
# Format Control
#===============================================================================

# Set output format
# Args: format (text|json|syslog)
vde_log_set_format() {
    local format="${(U)1:-TEXT}"
    
    case "${format}" in
        TEXT|JSON|SYSLOG)
            VDE_LOG_FORMAT="${(L)format}"
            return 0
            ;;
        *)
            return ${VDE_ERR_GENERAL}
            ;;
    esac
}

#===============================================================================
# Output Control
#===============================================================================

# Configure logging to output to stdout
vde_log_to_stdout() {
    VDE_LOG_OUTPUT="stdout"
    return 0
}

# Configure logging to output to stderr
vde_log_to_stderr() {
    VDE_LOG_OUTPUT="stderr"
    return 0
}

#===============================================================================
# Core Logging Functions
#===============================================================================

# Generic logging function
# Args: level, message, [component], [context...]
vde_log() {
    # Mandate 3: Support VDE_QUIET for clean output
    # Also suppress in test mode to ensure clean verification
    if [[ "${VDE_QUIET:-0}" == "1" || "${VDE_TEST_MODE:-0}" == "1" ]]; then
        local level_upper="${(U)1}"
        if [[ "${level_upper}" == "INFO" || "${level_upper}" == "DEBUG" ]]; then
            return 0
        fi
    fi

    local level="${1}"
    local message="${2}"
    local component="${3:-vde}"
    local context=""
    
    # Only shift if we have at least 3 args
    if [[ ${#} -ge 3 ]] ; then
        shift 3
        context="${@}"
    fi
    
    # Validate level
    level="${(U)level}"
    if [[ -z "${VDE_LOG_LEVELS[${level}]}" ]] ; then
        level="INFO"
    fi
    
    # Check if we should log this level
    local level_num="${VDE_LOG_LEVELS[${level}]}"

    if [[ "${level_num}" -lt "${_VDE_LOG_CURRENT_LEVEL}" ]] ; then
        return 0
    fi
    
    # Ensure initialized
    if [[ "${_VDE_LOG_INITIALIZED}" -eq 0 ]] ; then
        vde_log_init || return ${VDE_ERR_GENERAL}
    fi
    
    # Generate timestamp (ISO 8601)
    local timestamp
    timestamp=$(vde_shell_date_iso8601)
    
    # Format based on output type
    local output
    case "${VDE_LOG_FORMAT}" in
        json)
            output=$(vde_log_format_json "${timestamp}" "${level}" "${component}" "${message}" "${context}")
            ;;
        syslog)
            output=$(vde_log_format_syslog "${timestamp}" "${level}" "${component}" "${message}")
            ;;
        *)
            output=$(vde_log_format_text "${timestamp}" "${level}" "${component}" "${message}")
            ;;
    esac
    
    # Check for rotation before writing
    vde_log_check_rotation
    
    # Write output
    case "${VDE_LOG_OUTPUT}" in
        file)
            echo "${output}" >> "${VDE_LOG_FILE}"
            ;;
        stdout)
            echo "${output}"
            ;;
        stderr)
            echo "${output}" >&2
            ;;
    esac
    
    return 0
}

# Level-specific logging functions
vde_log_debug() {
    vde_log "DEBUG" "${@}"
}

vde_log_info() {
    vde_log "INFO" "${@}"
}

vde_log_warn() {
    vde_log "WARN" "${@}"
}

vde_log_error() {
    vde_log "ERROR" "${@}"
}

vde_log_success() {
    vde_log "INFO" "${@}"
}

#===============================================================================
# Formatting Helpers
#===============================================================================

# Format log as human-readable text
vde_log_format_text() {
    local timestamp="${1}"
    local level="${2}"
    local component="${3}"
    local message="${4}"
    
    local level_color
    case "${level}" in
        DEBUG) level_color="\033[0;36m" ;; # Cyan
        INFO)  level_color="\033[0;32m" ;; # Green
        WARN)  level_color="\033[1;33m" ;; # Yellow
        ERROR) level_color="\033[0;31m" ;; # Red
        *)     level_color="\033[0m"    ;;
    esac
    
    printf "%s [%-5s] [%-10s] %s\033[0m\n" "${timestamp}" "${level}" "${component}" "${message}"
}

# Format log as JSON
vde_log_format_json() {
    local timestamp="${1}"
    local level="${2}"
    local component="${3}"
    local message="${4}"
    local context="${5}"
    
    # Escape special characters in message and context
    message=$(echo "${message}" | command sed 's/\\/\\\\/g; s/"/\\"/g; s/\t/\\t/g; s/\r/\\r/g; s/\n/\\n/g')
    
    local json
    json="{\"timestamp\":\"${timestamp}\",\"level\":\"${level}\",\"component\":\"${component}\",\"message\":\"${message}\"}"
    
    if [[ -n "${context}" ]]; then
        context=$(echo "${context}" | command sed 's/\\/\\\\/g; s/"/\\"/g; s/\t/\\t/g; s/\r/\\r/g; s/\n/\\n/g')
        json="${json%\} } ,\"context\":\"${context}\"}"
    fi
    
    echo "${json}"
}

# Format log for Syslog (simplified)
vde_log_format_syslog() {
    local timestamp="${1}"
    local level="${2}"
    local component="${3}"
    local message="${4}"
    
    echo "${timestamp} vde[${component}]: ${level}: ${message}"
}

#===============================================================================
# Log Rotation
#===============================================================================

# Check if log file needs rotation
vde_log_check_rotation() {
    [[ "${VDE_LOG_OUTPUT}" != "file" ]] && return 0
    [[ ! -f "${VDE_LOG_FILE}" ]] && return 0
    
    # Get current file size (Zsh native stat)
    zmodload zsh/stat 2>/dev/null
    local size
    size=$(stat +size "${VDE_LOG_FILE}" 2>/dev/null)
    
    if [[ -n "${size}" ]] && [[ "${size}" -ge "${VDE_LOG_MAX_SIZE}" ]] ; then
        vde_log_rotate
    fi
}

# Rotate log files
vde_log_rotate() {
    local max_backups=5
    local base_file="${VDE_LOG_FILE}"
    
    # Remove oldest backup
    [[ -f "${base_file}.${max_backups}" ]] && command rm -f "${base_file}.${max_backups}"
    
    # Shift existing backups
    for i in {${max_backups}..1}; do
        local old="${base_file}.${i}"
        local new="${base_file}.$((i + 1))"
        [[ -f "${old}" ]] && command mv "${old}" "${new}"
    done
    
    # Move current file to .1
    command mv "${base_file}" "${base_file}.1"
    command touch "${base_file}"
}

# Cleanup old log files
vde_log_cleanup() {
    if [[ -d "${VDE_ROOT_DIR}/logs" ]] ; then
        command rm -f "${VDE_ROOT_DIR}/logs"/*.log*
    fi
    return 0
}

# =============================================================================
# EXPORTS & COMPATIBILITY
# =============================================================================

# Note: ZSH does not support 'export -f'. Functions are available to subshells
# if they are defined in a sourced script or autoloaded.
# VDE scripts source the required libraries directly.

# Legacy log function (maps to vde_log_info)
_vde_log() {
    vde_log_info "${@}"
}
