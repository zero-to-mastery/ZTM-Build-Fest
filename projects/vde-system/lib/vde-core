}

# -----------------------
# Lazy Loading Support
# -----------------------
# These variables track which optional modules have been loaded
_VDE_SSH_LOADED=0
_VDE_DOCKER_LOADED=0
_VDE_TEMPLATE_LOADED=0

# vde_require_ssh - Ensure SSH functions are available
vde_require_ssh() {
    if [[ "${_VDE_SSH_LOADED}" == "0" ]] ; then
        # 1. Verify binary availability
        if ! command -v ssh >/dev/null 2>&1; then
            return ${VDE_ERR_NOT_FOUND:-3}
        fi
        # 2. Verify identity existence (The Transversal Bridge)
        local vde_key="${HOME}/.ssh/vde/vde_student"
        if [[ ! -f "${vde_key}" ]]; then
            # Log warning but don't fail, as some commands might not need the identity yet
            log_warning "VDE identity not found at ${vde_key}"
        fi
        _VDE_SSH_LOADED=1
    fi
    return ${VDE_SUCCESS:-0}
}

# vde_require_docker - Ensure Docker functions are available
vde_require_docker() {
    if [[ "${_VDE_DOCKER_LOADED}" == "0" ]] ; then
        # 1. Verify binary
        if ! command -v docker >/dev/null 2>&1; then
            return ${VDE_ERR_NOT_FOUND:-3}
        fi
        # 2. Verify daemon responsiveness (The World-Forge)
        # We use 'docker info' as it is the canonical probe for daemon health
        if ! docker info >/dev/null 2>&1; then
            log_error "Docker daemon is not responsive. Is it running?"
            return ${VDE_ERR_GENERAL:-1}
        fi
        _VDE_DOCKER_LOADED=1
    fi
    return ${VDE_SUCCESS:-0}
}

# vde_require_template - Ensure template functions are available
vde_require_template() {
    if [[ "${_VDE_TEMPLATE_LOADED}" == "0" ]] ; then
        if [[ -z "${CONFIGS_DIR:-}" ]] ; then
            # shellcheck source=vm-common
            . "${VDE_ROOT_DIR}/lib/vm-common"
        fi
        _VDE_TEMPLATE_LOADED=1
    fi
    return ${VDE_SUCCESS:-0}
}

# -----------------------
# JSON Schema Validation
# -----------------------
# Centralized schema validation and cache regeneration for all VDE libraries

# vde_check_schema_integrity - Verify schema file is valid JSON with required structure
# Args: <schema_file>
# Returns: VDE_SUCCESS if valid, VDE_ERR_INVALID_DATA if invalid
vde_check_schema_integrity() {
    local schema_file="${1}"

    if [[ ! -f "${schema_file}" ]] ; then
        log_error "Schema file not found: ${schema_file}"
        return ${VDE_ERR_NOT_FOUND:-3}
    fi

    # Check if valid JSON
    if ! python3 -c "import json; json.load(open('${schema_file}'))" 2>/dev/null; then
        log_error "Schema file is not valid JSON: ${schema_file}"
        return ${VDE_ERR_INVALID_DATA:-4}
    fi

    # Check for required schema fields
    if ! python3 -c "
import json
with open('${schema_file}') as f:
    schema = json.load(f)
assert '\$schema' in schema or 'type' in schema, 'Missing required schema fields'
" 2>/dev/null; then
        log_error "Schema file missing required fields: ${schema_file}"
        return ${VDE_ERR_INVALID_DATA:-4}
    fi

    return ${VDE_SUCCESS:-0}
}

# vde_validate_json_schema - Validate JSON file against its schema
# Args: <json_file> <schema_file>
# Returns: VDE_SUCCESS if valid, VDE_ERR_INVALID_DATA if invalid, VDE_ERR_NOT_FOUND if file missing
vde_validate_json_schema() {
    local json_file="${1}"
    local schema_file="${2}"

    # Check files exist
    if [[ ! -f "${json_file}" ]] ; then
        log_error "JSON file not found: ${json_file}"
        return ${VDE_ERR_NOT_FOUND:-3}
    fi

    if [[ ! -f "${schema_file}" ]] ; then
        log_error "Schema file not found: ${schema_file}"
        return ${VDE_ERR_NOT_FOUND:-3}
    fi

    # Verify schema integrity first
    if ! vde_check_schema_integrity "${schema_file}"; then
        return ${VDE_ERR_INVALID_DATA:-4}
    fi

    # Validate JSON against schema
    if python3 -c "
import json, sys

try:
    with open('${schema_file}') as f:
        schema = json.load(f)
    with open('${json_file}') as f:
        data = json.load(f)
    
    # Try using jsonschema if installed
    try:
        import jsonschema
        jsonschema.validate(instance=data, schema=schema)
        sys.exit(0)
    except ImportError:
        # Fallback to basic structural validation if jsonschema not available
        if schema.get('type') == 'object':
            required = schema.get('required', [])
            for field in required:
                if field not in data:
                    print(f'Missing required field: {field}', file=sys.stderr)
                    sys.exit(1)
        sys.exit(0)
    except Exception as e:
        print(f'Schema validation error: {e}', file=sys.stderr)
        sys.exit(1)
except Exception as e:
    print(f'Validation script error: {e}', file=sys.stderr)
    sys.exit(1)
" ; then
        : # Success
    else
        log_error "JSON validation failed: ${json_file}"
        return ${VDE_ERR_INVALID_DATA:-4}
    fi

    log_info "Schema validation passed: ${json_file}"
    return ${VDE_SUCCESS:-0}
}

# vde_validate_or_regenerate - Validate JSON, regenerate cache if needed
# Args: <json_file> <schema_file> <cache_file>
# Returns: VDE_SUCCESS if valid/regenerated, error code otherwise
vde_validate_or_regenerate() {
    local json_file="${1}"
    local schema_file="${2}"
    local cache_file="${3}"

    # Validate JSON against schema
    if ! vde_validate_json_schema "${json_file}" "${schema_file}" >/dev/null; then
        log_error "JSON validation failed, cannot regenerate cache"
        return ${VDE_ERR_INVALID_DATA:-4}
    fi

    # Check if cache needs regeneration
    local needs_regen=0

    if [[ ! -f "${cache_file}" ]] ; then
        log_info "Cache file missing, will regenerate: ${cache_file}"
        needs_regen=1
    elif [[ "${json_file}" -nt "${cache_file}" ]] ; then
        log_info "JSON file newer than cache, will regenerate: ${cache_file}"
        needs_regen=1
    fi

    if [[ ${needs_regen} == 1 ]] ; then
        log_info "Regenerating cache from validated JSON: ${cache_file}"
        # Cache regeneration happens in load_vm_types in vm-common
        # This function just validates and signals need for regeneration
        return ${VDE_ERR_CACHE_INVALID:-5}
    fi

    return ${VDE_SUCCESS:-0}
}

# vde_get_schema_for_json - Get schema file path for a JSON config file
# Args: <json_file>
# Returns: Outputs schema file path, returns VDE_SUCCESS if found
vde_get_schema_for_json() {
    local json_file="${1}"
    local schema_file="${json_file%.json}.schema.json"

    if [[ -f "${schema_file}" ]] ; then
        echo "${schema_file}"
        return ${VDE_SUCCESS:-0}
    fi

    log_error "No schema found for: ${json_file}"
    return ${VDE_ERR_NOT_FOUND:-3}
}

# -----------------------
# Schema Update Mechanisms
# -----------------------
# Functions for detecting schema changes and updating configurations

# vde_get_config_version - Get version from JSON config file
# Args: <json_file>
# Returns: Outputs version string, returns VDE_SUCCESS if found
vde_get_config_version() {
    local json_file="${1}"

    if [[ ! -f "${json_file}" ]] ; then
        log_error "Config file not found: ${json_file}"
        return ${VDE_ERR_NOT_FOUND:-3}
    fi

    local version
    version=$(python3 -c "import json; print(json.load(open('${json_file}')).get('version', ''))" 2>/dev/null)

    if [[ -n "${version}" ]] ; then
        echo "${version}"
        return ${VDE_SUCCESS:-0}
    else
        log_error "No version field in config: ${json_file}"
        return ${VDE_ERR_NOT_FOUND:-3}
    fi
}

# vde_get_schema_version - Get version requirement from schema file
# Args: <schema_file>
# Returns: Outputs schema version pattern, returns VDE_SUCCESS if found
vde_get_schema_version() {
    local schema_file="${1}"

    if [[ ! -f "${schema_file}" ]] ; then
        log_error "Schema file not found: ${schema_file}"
        return ${VDE_ERR_NOT_FOUND:-3}
    fi

    local version
    version=$(python3 -c "
import json
schema = json.load(open('${schema_file}'))
# Get version from properties.version.pattern or properties.version.const
version_prop = schema.get('properties', {}).get('version', {})
print(version_prop.get('pattern', version_prop.get('const', '')))
" 2>/dev/null)

    if [[ -n "${version}" ]] ; then
        echo "${version}"
        return ${VDE_SUCCESS:-0}
    else
        log_error "No version in schema: ${schema_file}"
        return ${VDE_ERR_NOT_FOUND:-3}
    fi
}

# vde_check_schema_compatibility - Check if config version matches schema
# Args: <json_file> <schema_file>
# Returns: VDE_SUCCESS if compatible, VDE_ERR_INVALID_DATA if incompatible
vde_check_schema_compatibility() {
    local json_file="${1}"
    local schema_file="${2}"

    local config_version schema_version
    config_version=$(vde_get_config_version "${json_file}" 2>/dev/null)
    schema_version=$(vde_get_schema_version "${schema_file}" 2>/dev/null)

    if [[ -z "${config_version}" ]] ; then
        log_error "Cannot determine config version: ${json_file}"
        return ${VDE_ERR_INVALID_DATA:-4}
    fi

    if [[ -z "${schema_version}" ]] ; then
        log_error "Cannot determine schema version: ${schema_file}"
        return ${VDE_ERR_INVALID_DATA:-4}
    fi

    # Check if config version matches schema pattern
    if python3 -c "
import re, sys
pattern = r'${schema_version}'
version = '${config_version}'
if re.match(pattern, version):
    sys.exit(0)
else:
    sys.exit(1)
" 2>/dev/null; then
        log_info "Config version ${config_version} compatible with schema"
        return ${VDE_SUCCESS:-0}
    else
        log_error "Config version ${config_version} incompatible with schema ${schema_version}"
        return ${VDE_ERR_INVALID_DATA:-4}
    fi
}

# vde_detect_schema_changes - Detect if schema has been updated
# Args: <json_file>
# Returns: VDE_SUCCESS if schema unchanged, VDE_ERR_CACHE_INVALID if schema changed
vde_detect_schema_changes() {
    local json_file="${1}"
    local schema_file
    schema_file=$(vde_get_schema_for_json "${json_file}" 2>/dev/null)

    if [[ ! -f "${schema_file}" ]] ; then
        log_error "Schema file not found for: ${json_file}"
        return ${VDE_ERR_NOT_FOUND:-3}
    fi

    # Check if schema file is newer than config
    if [[ "${schema_file}" -nt "${json_file}" ]] ; then
        log_info "Schema has been updated, config may need regeneration"
        return ${VDE_ERR_CACHE_INVALID:-5}
    fi

    return ${VDE_SUCCESS:-0}
}

# vde_backup_config - Create backup of config file before update
# Args: <json_file>
# Returns: VDE_SUCCESS if backup created, error code otherwise
vde_backup_config() {
    local json_file="${1}"
    local backup_dir="${VDE_ROOT_DIR}/.cache/config-backups"
    local timestamp
    timestamp=$(date +%Y%m%d_%H%M%S)
    local backup_file="${backup_dir}/$(basename "${json_file}").${timestamp}.bak"

    if [[ ! -f "${json_file}" ]] ; then
        log_error "Config file not found: ${json_file}"
        return ${VDE_ERR_NOT_FOUND:-3}
    fi

    # Create backup directory
    mkdir -p "${backup_dir}" 2>/dev/null

    # Copy config to backup
    if cp "${json_file}" "${backup_file}" 2>/dev/null; then
        log_info "Config backed up to: ${backup_file}"
        echo "${backup_file}"
        return ${VDE_SUCCESS:-0}
    else
        log_error "Failed to create backup: ${backup_file}"
        return ${VDE_ERR_GENERAL:-1}
    fi
}

# vde_validate_and_update - Validate config and update cache if needed
# Args: <json_file> <schema_file> <cache_file>
# Returns: VDE_SUCCESS if validated/updated, error code otherwise
vde_validate_and_update() {
    local json_file="${1}"
    local schema_file="${2}"
    local cache_file="${3}"

    log_info "Validating and updating: ${json_file}"

    # Check compatibility
    if ! vde_check_schema_compatibility "${json_file}" "${schema_file}"; then
        log_error "Schema compatibility check failed"
        return ${VDE_ERR_INVALID_DATA:-4}
    fi

    # Validate against schema
    if ! vde_validate_json_schema "${json_file}" "${schema_file}" >/dev/null; then
        log_error "Schema validation failed"
        return ${VDE_ERR_INVALID_DATA:-4}
    fi

    # Check if cache needs update
    if [[ -n "${cache_file}" ]] ; then
        if [[ ! -f "${cache_file}" ]] || [[ "${json_file}" -nt "${cache_file}" ]] || [[ "${schema_file}" -nt "${cache_file}" ]] ; then
            log_info "Cache needs regeneration"
            return ${VDE_ERR_CACHE_INVALID:-5}
        fi
    fi

    log_info "Validation and update check complete"
    return ${VDE_SUCCESS:-0}
}

# -----------------------
# Performance Timing (Debug)
# -----------------------
# Set VDE_DEBUG_TIMING=1 to enable timing output

# vde_time_start - Start a timing measurement
# Args: <label>
vde_time_start() {
    local label="${1}"
    if [[ "${VDE_DEBUG_TIMING:-0}" == "1" ]] ; then
        eval "_VDE_TIME_${label}=\"\$(date +%s%N 2>/dev/null || date +%s)\""
    fi
}

# vde_time_end - End a timing measurement and print result
# Args: <label>
vde_time_end() {
    local label="${1}"
    if [[ "${VDE_DEBUG_TIMING:-0}" == "1" ]] ; then
        local start_var="_VDE_TIME_${label}"
        local start_time
        eval "start_time=\"\${${start_var}:-0}\""
        local end_time
        end_time=$(date +%s%N 2>/dev/null || date +%s)
        
        if [[ "${start_time}" != "0" ]] ; then
            # Calculate duration in milliseconds
            local duration_ns=$((end_time - start_time))
            local duration_ms=$((duration_ns / 1000000))
            echo "[TIMING] ${label}: ${duration_ms}ms" >&2
        fi
    fi
}

#===============================================================================
# Next Steps Helper - Guidance for Students and New Hires
#===============================================================================
# Displays contextual next steps based on the command just executed.
# Always ends with 'vde list' as the final suggestion.
#
# Usage: vde_print_next_steps <command_type> [vm_name]
#
# Examples:
#   vde_print_next_steps "init"
#   vde_print_next_steps "start" "python"
#   vde_print_next_steps "rm" "python"
#===============================================================================
vde_print_next_steps() {
    local cmd_type="${1:-}"
    local vm_name="${2:-}"
    local vm_alias="${vm_name#vde-}"

    echo ""
    echo "Next:"

    case "${cmd_type}" in
        init)
            echo "  vde create <name>  - forge your first VM (e.g., vde create python)"
            ;;
        create|rebuild)
            if [[ -n "${vm_alias}" ]]; then
                echo "  vde start ${vm_alias}   - ignite your VM"
            else
                echo "  vde start <name>   - ignite your VM"
            fi
            ;;
        start)
            if [[ -n "${vm_alias}" ]]; then
                echo "  vde enter ${vm_alias}   - enter your VM"
            else
                echo "  vde enter <name>   - enter your VM"
            fi
            ;;
        stop)
            if [[ -n "${vm_alias}" ]]; then
                echo "  vde start ${vm_alias}   - re-ignite your VM"
            else
                echo "  vde start <name>   - re-ignite your VM"
            fi
            ;;
        rm|remove)
            if [[ -n "${vm_alias}" ]]; then
                echo "  vde create ${vm_alias}  - re-forge your VM"
            else
                echo "  vde create <name>  - re-forge your VM"
            fi
            ;;
        add)
            if [[ -n "${vm_alias}" ]]; then
                echo "  vde create ${vm_alias}  - forge the new VM type"
            else
                echo "  vde create <name>  - forge the new VM type"
            fi
            ;;
        uninstall)
            echo "  vde create <name>  - forge a new VM type"
            ;;
        restart)
            if [[ -n "${vm_alias}" ]]; then
                echo "  vde enter ${vm_alias}   - enter your VM"
            else
                echo "  vde enter <name>   - enter your VM"
            fi
            ;;
        *)
            # Generic fallback
            echo "  vde help           - view all commands"
            ;;
    esac

    echo "  vde list           - list status of all created Spokes"
}
