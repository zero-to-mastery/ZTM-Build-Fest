# _vde_core_get_mtime - Get file modification time
_vde_core_get_mtime() {
    local filepath="${1}"
    if [[ -f "${filepath}" ]] ; then
        if [[ "$(uname)" == "Darwin" ]] ; then
            stat -f %m "${filepath}" 2>/dev/null || echo "0"
        else
            stat -c %Y "${filepath}" 2>/dev/null || echo "0"
        fi
    else
        echo "0"
    fi
}

# vde_purge_ghosts - BTO Purge Ritual (Rule 12.5)
# Ensures image immutability by removing all transient apt artifacts.
vde_purge_ghosts() {
    if command -v apt-get >/dev/null 2>&1; then
        apt-get clean 2>/dev/null
        rm -rf /var/lib/apt/lists/*
        rm -rf /var/cache/apt/archives/*
        # Ensure the directory exists but is empty (Rule 12.5 compliance)
        mkdir -p /var/lib/apt/lists/partial
    fi
}

# vde_query_json - Zero-Host-Dependency JQ Wrapper (The Scavenger's Ban)
# Adheres to Rule G: Prevents host dependency by falling back to Docker
# Args: <jq_args> (variable)
vde_query_json() {
    if command -v jq >/dev/null 2>&1; then
        jq "$@"
    else
        # --- PATH TRANSLATION (Rule G Hardening) ---
        # If the host lacks JQ, we must translate host-absolute paths to the /vde container mount.
        local args=()
        local arg
        for arg in "$@"; do
            # Replace VDE_ROOT_DIR with /vde for container execution
            if [[ "${arg}" == "${VDE_ROOT_DIR}"* ]]; then
                args+=("${arg/${VDE_ROOT_DIR}//vde}")
            else
                args+=("${arg}")
            fi
        done
        
        # Use -i for interactive/stdin pipe support
        docker run --rm -i -v "${VDE_ROOT_DIR}:/vde" vde-base jq "${args[@]}"
    fi
}

# The Armorer's Translator: Hammers .conf (pipe) into .json
# Adheres to Rule G: Uses pure ZSH to avoid host JQ dependencies during smelting.
vde_translate_conf_to_json() {
    # Force disable xtrace to prevent assignment output (Rule G / Zero-Host portability)
    unsetopt XTRACE 2>/dev/null
    local _v_conf_file="$1"
    local _v_json_file="$2"

    # GLOBAL CONFIGURATION LOCK: Ensure atomic translation
    local global_lock="${VDE_LOCKS_DIR}/global-config.lock"
    if [[ "${VDE_NO_LOCK:-0}" != "1" ]]; then
        claim_lock "${global_lock}" || return ${VDE_ERR_LOCK}
    fi

    {
        # Double-check if another process already translated while we waited
        if [[ -f "$_v_json_file" && ! ("$_v_conf_file" -nt "$_v_json_file") ]]; then
            vde_log_info "Pure Beskar already reconciled (Concurrency Win)." "forge"
            if [[ "${VDE_NO_LOCK:-0}" != "1" ]]; then
                release_lock "${global_lock}"
            fi
            return ${VDE_SUCCESS}
        fi

        local -a _v_lang_entries=()
        local -a _v_svc_entries=()

        # Helper to escape JSON strings (The Scavenger's Escaper)
        _vde_escape_json() {
            local _v_str="$1"
            _v_str="${_v_str//\\/\\\\}" # Backslashes
            _v_str="${_v_str//\"/\\\"}" # Quotes
            _v_str="${_v_str//$'\n'/\\n}" # Newlines
            echo -n "$_v_str"
        }

        local _v_category _v_aliases_json _v_cmd_json _v_svc_json _v_ssh_port_json _v_entry _v_a_item
        while IFS='|' read -r _v_type _v_name _v_aliases _v_disp _v_pkgs _v_cmd _v_env _v_port _extra; do
            [[ -z "${_v_name}" || "${_v_type}" == "#"* ]] && continue

            _v_category="language"
            [[ "${_v_type}" == "service" ]] && _v_category="service"

            # Build aliases array via Pure ZSH
            _v_aliases_json="[]"
            if [[ -n "${_v_aliases}" ]]; then
                local -a _v_a_list=()
                for _v_a_item in ${(s:,:)_v_aliases}; do
                    _v_a_list+=("\"$(_vde_escape_json "${_v_a_item}")\"")
                done
                _v_aliases_json="[${(j:,:)_v_a_list}]"
            fi

            local _v_pkgs_json="null"
            [[ -n "${_v_pkgs}" ]] && _v_pkgs_json="\"$(_vde_escape_json "${_v_pkgs}")\""

            local _v_cmd_json="null"
            [[ -n "${_v_cmd}" ]] && _v_cmd_json="\"$(_vde_escape_json "${_v_cmd}")\""

            local _v_svc_json="null"
            [[ -n "${_v_env}" ]] && _v_svc_json="\"$(_vde_escape_json "${_v_env}")\""

            local _v_ssh_port_json="null"
            [[ -n "${_v_port}" ]] && _v_ssh_port_json="${_v_port}"

            local _v_entry="        {
              \"name\": \"$(_vde_escape_json "${_v_name}")\",
              \"aliases\": ${_v_aliases_json},
              \"display\": \"$(_vde_escape_json "${_v_disp}")\",
              \"pkgs\": ${_v_pkgs_json},
              \"custom_cmd\": ${_v_cmd_json},
              \"service_ports\": ${_v_svc_json},
              \"ssh_port\": ${_v_ssh_port_json}
            }"

            if [[ "${_v_category}" == "service" ]]; then
                _v_svc_entries+=("${_v_entry}")
            else
                _v_lang_entries+=("${_v_entry}")
            fi
        done < "$_v_conf_file"

        # Build final JSON using Pure Beskar template
        local _v_json_tmp="${_v_json_file}.tmp.${$}"
        {
            echo "{"
            echo "  \"@armor\": \"(Beskar Registry DNA)\","
            echo "  \"version\": \"${VDE_VERSION:-$(vde_get_version)}\","
            echo "  \"vms\": {"
            echo "    \"language\": ["
            echo "${(j:,\n:)_v_lang_entries}"
            echo "    ],"
            echo "    \"service\": ["
            echo "${(j:,\n:)_v_svc_entries}"
            echo "    ]"
            echo "  }"
            echo "}"
        } > "$_v_json_tmp"

        mv "$_v_json_tmp" "$_v_json_file"
        vde_log_success "The Pure Beskar (.json) has been reconciled via Pure ZSH." "forge"
    }
    if [[ "${VDE_NO_LOCK:-0}" != "1" ]]; then
        release_lock "${global_lock}"
    fi
}
