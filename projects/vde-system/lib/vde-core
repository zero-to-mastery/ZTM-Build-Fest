# -----------------------
# VDE Versioning
# -----------------------
# The Rule of One: Extract version from the Beskar Source (docs/governance/vde-spec.md)
vde_get_version() {
    # Resolve the root directory relative to the current context
    local root="${VDE_ROOT_DIR:-.}"
    local spec_file="${root}/docs/governance/vde-spec.md"

    if [[ -f "${spec_file}" ]]; then
        # Extracts version from "# VDE-SPEC [v]1.5.6 (The Sovereign Baseline)"
        # Supports optional 'v' prefix and SemVer extensions like -spN
        grep -m1 '^# VDE-SPEC ' "${spec_file}" | sed -E 's/^# VDE-SPEC v?([0-9]+\.[0-9]+\.[0-9]+(-sp[0-9]+)?).*/\1/' | tr -d '[:space:]'
    else
        # Strike failed: File not found
        echo "0.0.0-unknown"
    fi
}
# Export it so the entire ecosystem sees the same number
export VDE_VERSION=$(vde_get_version)

