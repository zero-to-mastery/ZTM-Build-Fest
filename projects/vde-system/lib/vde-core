# vde_run - The Deterministic Execution Wrapper (Phase 26)
# Wraps commands, captures exit codes, and triggers the Error Engine.
# Args: <info_context> <command...>
vde_run() {
    local info="${1}"
    shift
    local cmd=("$@")

    # TRACE MODE INTERCEPTION: If tracing, capture final intent and skip execution
    if [[ -n "${VDE_TRACE_MODE}" ]]; then
        # 1. ALLOW read-only helpers needed for state resolution
        if [[ "${cmd[1]}" == "vde_query_json" ]]; then
            "${cmd[@]}"
            return $?
        fi

        # 2. DIVE into leaf wrappers to get the final execution command
        local final_cmd=""
        if [[ "${cmd[1]}" == *"/ssh-vm" || "${cmd[1]}" == *"/vde-exec" ]]; then
            # Execute with --show-command to resolve the final SSH/Docker call
            # Note: ${cmd[2,-1]} gives elements from 2nd to last (Zsh 1-indexed range)
            local raw_output resolved_path
            resolved_path="${cmd[1]:a}"
            raw_output=$("${resolved_path}" --show-command --quiet "${(@)cmd[2,-1]}" 2>&1) || true
            # Strip ANSI codes and find the actual command line (starts with ssh or docker)
            final_cmd="$(echo "${raw_output}" | sed $'s/\x1b\\[[0-9;]*m//g' | grep -E "^[[:space:]]*(ssh|docker) " | head -n 1 | sed 's/^[[:space:]]*//')"
            if [[ -n "${final_cmd}" ]]; then
                if [[ -n "${VDE_TRACE_FILE:-}" ]]; then
                    print -r -- "EXEC	${_VDE_TRACE_CALL_DEPTH}	${final_cmd}		" >> "${VDE_TRACE_FILE}"
                fi
                return 0
            fi
        fi

        # 3. For docker/ssh commands, invoke them (shims will intercept and record EXEC)
        if [[ "${cmd[1]}" == "docker" || "${cmd[1]}" == "ssh" ]]; then
            "${cmd[@]}"
            return $?
        fi

        # 4. For external scripts, EXECUTE them so they can trace their own functions
        # The script will source vde-trace-bootstrap and install its own wrappers
        if [[ -f "${cmd[1]}" || "${cmd[1]}" == "/"* ]] && [[ -x "${cmd[1]:a}" ]]; then
            # Execute the script - it will inherit VDE_TRACE_MODE and install its own tracers
            "${cmd[@]}"
            return $?
        fi
    fi
    
    # Execute actual command
    "${cmd[@]}"
    local rc=$?
    
    # If failure detected, hand off to Error Engine
    if [[ $rc -ne 0 ]]; then
        # SPECIAL CASE: For 'exec' or 'enter', we return the actual exit code 
        # without triggering the Hub's error engine, as the Spoke's command 
        # might return non-zero for legitimate reasons (e.g. ssh-add -l empty).
        if [[ "${info}" == "exec" || "${info}" == "enter" || "${info}" == "ssh" ]]; then
            return $rc
        fi

        if command -v vde_error_map >/dev/null 2>&1; then
            vde_error_map $rc "${info}"
        else
            echo "[ERROR] ${info} failed with code ${rc}" >&2
        fi
        return $rc
    fi
    return 0
}

