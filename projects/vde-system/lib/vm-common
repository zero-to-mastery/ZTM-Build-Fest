# load_docker_config - Load VM Docker configuration from JSON
# This function loads docker-compose file locations, env files, and mount paths
# Returns: VDE_SUCCESS if loaded, error code otherwise
# =============================================================================
# SPOKE METADATA DERIVATION
# =============================================================================

# get_vm_compose_file - Derives compose file path from Hub name
# Args: <vm_name>
get_vm_compose_file() {
    local vm_name="${1}"
    local category
    category=$(get_vm_category "${vm_name}")
    local raw_name
    raw_name=$(vde_normalize_name "${vm_name}")
    
    if [[ "${category}" != "unknown" ]]; then
        echo "configs/docker/${category}/${raw_name}/docker-compose.yml"
    else
        echo "configs/docker/${raw_name}/docker-compose.yml"
    fi
}

# get_vm_env_file - Derives env file path from Hub name
# Args: <vm_name>
get_vm_env_file() {
    local raw_name
    raw_name=$(vde_normalize_name "${1}")
    local expected="env-files/${raw_name}.env"
    local legacy="env-files/vde-${raw_name}.env"

    if [[ -f "${VDE_ROOT_DIR}/${expected}" ]] && [[ -f "${VDE_ROOT_DIR}/${legacy}" ]]; then
        # Log to stderr so it doesn't interfere with command substitution capturing stdout
        vde_log_warn "Ambiguous environment files detected for ${raw_name}. Using ${expected}, ignoring legacy ${legacy}." "vde" >&2
    fi

    echo "${expected}"
}

# get_vm_image - Derives image name from Hub name
# Args: <vm_name>
get_vm_image() {
    local raw_name
    raw_name=$(vde_normalize_name "${1}")
    echo "vde-${raw_name}:latest"
}

# get_vm_mounts - Derives volume mounts from Hub name/category
# Args: <vm_name>
# Returns: format: src:dst|src:dst
get_vm_mounts() {
    local vm_name="${1}"
    local category
    category=$(get_vm_category "${vm_name}")
    local raw_name
    raw_name=$(vde_normalize_name "${vm_name}")
    
    local src_path dst_path
    # Base mounts for all VMs
    local mounts=".:/vde:ro"
    
    if [[ "${raw_name}" == "jupyterlab" ]]; then
        src_path="projects/python/jupyterlabs"
        dst_path="/home/devuser/workspace"
    elif [[ "${category}" == "languages" ]]; then
        src_path="projects/${raw_name}"
        dst_path="/home/devuser/workspace"
    elif [[ "${category}" == "services" ]]; then
        src_path="data/${raw_name}"
        dst_path="/data"
        # Spoke override for postgres
        [[ "${raw_name}" == *"postgres"* ]] && dst_path="/var/lib/postgresql/data"
    else
        src_path="projects/${raw_name}"
        dst_path="/home/devuser/workspace"
    fi
    
    echo "${mounts}|${src_path}:${dst_path}|logs/${raw_name}:/logs"
}

# get_docker_config - Get Docker config value for a VM (legacy wrapper)
# Args: <field> <vm_name>
# Returns: Outputs field value, or error
get_docker_config() {
    local field="${1}"
    local vm_name="${2}"
    
    case "${field}" in
        compose_file) get_vm_compose_file "${vm_name}" ;;
        env_file) get_vm_env_file "${vm_name}" ;;
        image) get_vm_image "${vm_name}" ;;
        workspace_mount|data_mount|logs_mount) 
            # This is a bit complex due to legacy field expectations
            # Most scripts now use the direct get_vm_* functions
            get_vm_mounts "${vm_name}" | tr '|' '\n' | grep "${field%_mount}" | cut -d: -f1
            ;;
        *) return ${VDE_ERR_NOT_FOUND} ;;
    esac
    return ${VDE_SUCCESS}
}

# regenerate_vm_types_cache - Force regeneration of VM types cache
# This function validates the JSON config and rebuilds the cache from scratch
# Returns: VDE_SUCCESS if regenerated, error code otherwise
regenerate_vm_types_cache() {
    _info "Forcing VM types cache regeneration..."

    # Get schema file
    local schema_file
    schema_file=$(vde_get_schema_for_json "${VM_TYPES_JSON}" 2>/dev/null)

    # Validate JSON config first
    if [[ -n "${schema_file}" && -f "${schema_file}" ]]; then
        if ! vde_validate_json_schema "${VM_TYPES_JSON}" "${schema_file}" >/dev/null; then
            _error "Cannot regenerate cache: JSON config validation failed"
            return ${VDE_ERR_INVALID_DATA}
        fi
    fi

    # Remove existing cache
    if [[ -f "${VM_TYPES_CACHE}" ]]; then
        _info "Removing old cache: ${VM_TYPES_CACHE}"
        rm -f "${VM_TYPES_CACHE}"
    fi

    # Reload VM types (will regenerate cache)
    load_vm_types --no-cache
}

# validate_vm_types_config - Validate VM types configuration without loading
# Returns: VDE_SUCCESS if valid, error code otherwise
validate_vm_types_config() {
    local schema_file
    schema_file=$(vde_get_schema_for_json "${VM_TYPES_JSON}" 2>/dev/null)

    if [[ -z "${schema_file}" || ! -f "${schema_file}" ]]; then
        _error "Schema file not found for ${VM_TYPES_JSON}"
        return ${VDE_ERR_NOT_FOUND}
    fi

    _info "Validating VM types config: ${VM_TYPES_JSON}"
    if vde_validate_json_schema "${VM_TYPES_JSON}" "${schema_file}" >/dev/null; then
        _success "VM types config validation passed"
        return ${VDE_SUCCESS}
    else
        _error "VM types config validation failed"
        return ${VDE_ERR_INVALID_DATA}
    fi
}

