# Load VM types from configuration file
# Uses cache if available and valid
# Format: type|name|aliases|display|pkgs|custom_cmd|service_ports|ssh_port
load_vm_types() {
    local no_cache=0
    [[ "${1}" == "--no-cache" ]] && no_cache=1
    [[ "${VDE_NO_CACHE:-0}" == "1" ]] && no_cache=1

    # Ensure arrays are globally declared
    typeset -gA VM_TYPE VM_ALIASES VM_DISPLAY VM_INSTALL VM_CUSTOM_CMD VM_SVC_PORTS VM_SSH_PORT
    typeset -ga lang_vms service_vms

    # Guard to prevent redundant loading in the same process
    # Skip guard if no-cache is requested or if arrays are not initialized
    if [[ "${no_cache}" -eq 0 ]] && [[ "${_VM_TYPES_LOADED:-0}" == "1" ]] && [[ ${#VM_TYPE[@]} -gt 0 ]]; then
        # Rebuild alias map if it was invalidated without reloading types
        if [[ "${_VM_ALIAS_MAP_BUILT:-0}" -eq 0 ]]; then
            typeset -gA VM_ALIAS_MAP
            VM_ALIAS_MAP=()
            local _vn
            {
                for _vn in "${lang_vms[@]}" "${service_vms[@]}"; do
                    VM_ALIAS_MAP[${_vn}]="${_vn}"
                    VM_ALIAS_MAP["vde-${_vn#vde-}"]="${_vn}"
                    local _al="${VM_ALIASES[${_vn}]}"
                    if [[ -n "${_al}" ]]; then
                        local _alias_name
                        for _alias_name in ${(s:,:)_al}; do
                            _alias_name="${_alias_name//[[:space:]]/}"
                            [[ -n "${_alias_name}" ]] && VM_ALIAS_MAP[${_alias_name}]="${_vn}"
                        done
                    fi
                    local _dp="${VM_DISPLAY[${_vn}]}"
                    [[ -n "${_dp}" ]] && VM_ALIAS_MAP[${(L)_dp}]="${_vn}"
                done
            } >/dev/null 2>&1
            _VM_ALIAS_MAP_BUILT=1
        fi
        return 0
    fi

    # 1. Try cache FIRST for maximum performance (unless --no-cache requested)
    local use_cache=0
    if [[ "${no_cache}" -eq 0 ]] && _is_cache_valid "${VM_TYPES_CACHE}" "${VM_TYPES_JSON}" "${VM_TYPES_CONF}"; then
        # Verify cache file has no syntax errors before sourcing
        if zsh -n "${VM_TYPES_CACHE}" 2>/dev/null; then
            # Load from cache - suppress output unless debugging
            if [[ "${VDE_LOG_LEVEL:-}" == "DEBUG" ]]; then
                . "${VM_TYPES_CACHE}"
            else
                . "${VM_TYPES_CACHE}" >/dev/null 2>&1
            fi
            if [[ $? -eq 0 ]]; then
                use_cache=1
                # Mark as loaded
                export _VM_TYPES_LOADED=1
            fi
        fi
    fi

    # 2. If cache failed, fall back to JSON/CONF
    if [[ "${use_cache}" -eq 0 ]]; then
        # GLOBAL CONFIGURATION LOCK: Prevent redundant re-smelting
        local global_lock="${VDE_LOCKS_DIR}/global-config.lock"
        if [[ "${VDE_NO_LOCK:-0}" != "1" ]]; then
            claim_lock "${global_lock}" || return ${VDE_ERR_LOCK}
        fi
        
        {
            # Double-check if another process just finished smelting the cache while we waited
            if [[ "${no_cache}" -eq 0 ]] && _is_cache_valid "${VM_TYPES_CACHE}" "${VM_TYPES_JSON}" "${VM_TYPES_CONF}"; then
                if zsh -n "${VM_TYPES_CACHE}" 2>/dev/null; then
                    . "${VM_TYPES_CACHE}" >/dev/null 2>&1 && {
                        use_cache=1
                        export _VM_TYPES_LOADED=1
                    }
                fi
            fi

            if [[ "${use_cache}" -eq 0 ]]; then
                _info "Loading VM types configuration..."

                # Clear existing arrays
                VM_TYPE=()
                VM_ALIASES=()
                VM_DISPLAY=()
                VM_INSTALL=()
                VM_CUSTOM_CMD=()
                VM_SVC_PORT=()
                VM_SSH_PORT=()

                local lang_vms_array=()
                local service_vms_array=()

                # Strategy: Use JQ if available (fastest for JSON), fallback to ZSH CONF parser (Rule G)
                if [[ -f "${VM_TYPES_JSON}" ]]; then
                    # Validate against schema (only when not using cache)
                    local schema_file
                    schema_file=$(vde_get_schema_for_json "${VM_TYPES_JSON}" 2>/dev/null)
                    if [[ -n "${schema_file}" && -f "${schema_file}" ]]; then
                        vde_validate_json_schema "${VM_TYPES_JSON}" "${schema_file}" >/dev/null 2>&1 || {
                            log_error "VM types JSON schema validation failed"
                            # If we fail validation, we MUST release the lock and return
                            [[ "${VDE_NO_LOCK:-0}" != "1" ]] && release_lock "${global_lock}"
                            return ${VDE_ERR_INVALID_DATA}
                        }
                    fi

                    _info "Parsing VM types from JSON via JQ: ${VM_TYPES_JSON}"
                    local _v_p_configs
                    _v_p_configs=$(vde_query_json -r '
                        (.vms.language[] | "VM_TYPE[\(.name)]=\("lang"|@sh);VM_ALIASES[\(.name)]=\(.aliases|join(",")|@sh);VM_DISPLAY[\(.name)]=\(.display|@sh);VM_INSTALL[\(.name)]=\(.pkgs//"-"|@sh);VM_CUSTOM_CMD[\(.name)]=\(.custom_cmd//""|@sh);VM_SVC_PORTS[\(.name)]=\(.service_ports//""|@sh);VM_SSH_PORT[\(.name)]=\(.ssh_port//""|@sh);lang_vms_array+=(\(.name|@sh))"),
                        (.vms.service[] | "VM_TYPE[\(.name)]=\("service"|@sh);VM_ALIASES[\(.name)]=\(.aliases|join(",")|@sh);VM_DISPLAY[\(.name)]=\(.display|@sh);VM_INSTALL[\(.name)]=\(.pkgs//"-"|@sh);VM_CUSTOM_CMD[\(.name)]=\(.custom_cmd//""|@sh);VM_SVC_PORTS[\(.name)]=\(.service_ports//""|@sh);VM_SSH_PORT[\(.name)]=\(.ssh_port//""|@sh);service_vms_array+=(\(.name|@sh))")
                    ' "${VM_TYPES_JSON}" 2>/dev/null)

                    if [[ -n "${_v_p_configs}" ]]; then
                        eval "${_v_p_configs}"
                    fi
                elif [[ -f "${VM_TYPES_CONF}" ]]; then
                    _info "Parsing VM types from Raw Beskar (.conf) via Pure ZSH..."
                    
                    # Extract version from comment header
                    local _v_conf_ver
                    _v_conf_ver=$(grep -m1 "^# Version:" "${VM_TYPES_CONF}" | awk '{print $3}' | tr -d '\r')
                    [[ -z "${_v_conf_ver}" ]] && _v_conf_ver=$(vde_get_version) # Dynamic fallback from Gospel


                    
                    local _v_type _v_name _v_aliases _v_disp _v_pkgs _v_cmd _v_env _v_port _v_extra
                    while IFS='|' read -r _v_type _v_name _v_aliases _v_disp _v_pkgs _v_cmd _v_env _v_port _v_extra; do
                        [[ -z "${_v_name}" || "${_v_type}" == "#"* ]] && continue
                        
                        local _v_cat="lang"
                        [[ "${_v_type}" == "service" ]] && _v_cat="service"
                        
                        VM_TYPE[${_v_name}]="${_v_cat}"
                        [[ "${_v_cat}" == "lang" ]] && lang_vms_array+=("${_v_name}")
                        [[ "${_v_cat}" == "service" ]] && service_vms_array+=("${_v_name}")
                        
                        VM_ALIASES[${_v_name}]="${_v_aliases}"
                        VM_DISPLAY[${_v_name}]="${_v_disp}"
                        VM_INSTALL[${_v_name}]="${_v_pkgs}"
                        VM_CUSTOM_CMD[${_v_name}]="${_v_cmd}"
                        VM_SVC_PORTS[${_v_name}]="${_v_env}"
                        VM_SSH_PORT[${_v_name}]="${_v_port}"
                    done < "${VM_TYPES_CONF}"
                else
                    _error "No configuration source found (JSON/CONF missing)"
                    [[ "${VDE_NO_LOCK:-0}" != "1" ]] && release_lock "${global_lock}"
                    return ${VDE_ERR_NOT_FOUND}
                fi

                # Export type indexes
                lang_vms=("${lang_vms_array[@]}")
                service_vms=("${service_vms_array[@]}")

                # ---------------------------------------------------------------------
                # Build VM_ALIAS_MAP (Optimization for vde-parser)
                # ---------------------------------------------------------------------
                # Clear existing MAP
                typeset -gA VM_ALIAS_MAP
                VM_ALIAS_MAP=()

                local _v_vm_name=""
                for _v_vm_name in "${lang_vms[@]}" "${service_vms[@]}"; do
                    # 1. Map canonical name
                    VM_ALIAS_MAP[${_v_vm_name}]="${_v_vm_name}"

                    # 2. Map prefixed name
                    local _v_prefixed="vde-${_v_vm_name#vde-}"
                    VM_ALIAS_MAP[${_v_prefixed}]="${_v_vm_name}"

                    # 3. Map aliases
                    local _v_aliases="${VM_ALIASES[${_v_vm_name}]}"
                    if [[ -n "${_v_aliases}" ]]; then
                        local _v_alias=""
                        for _v_alias in ${(s:,:)_v_aliases}; do
                            _v_alias="${_v_alias//[[:space:]]/}"
                            [[ -n "${_v_alias}" ]] && VM_ALIAS_MAP[${_v_alias}]="${_v_vm_name}"
                        done
                    fi

                    # 4. Map display name (lowercase, spaces stripped)
                    local _v_display="${VM_DISPLAY[${_v_vm_name}]}"
                    if [[ -n "${_v_display}" ]]; then
                        local _v_display_low="${(L)_v_display}"
                        _v_display_low="${_v_display_low//[[:space:]]/}"
                        [[ -n "${_v_display_low}" ]] && VM_ALIAS_MAP[${_v_display_low}]="${_v_vm_name}"
                    fi
                done
                _VM_ALIAS_MAP_BUILT=1

                # Create cache directory
                mkdir -p "${VDE_CACHE_DIR}"

                # Use the extracted version for the cache
                local _v_final_ver="${_v_conf_ver:-1.5.1}"
                [[ -f "${VM_TYPES_JSON}" ]] && _v_final_ver="1.5.1" # JSON is the primary authority

                # Generate cache file with proper zsh associative array syntax
                local cache_tmp="${VM_TYPES_CACHE}.tmp.${$}"
                {
                    echo "# VM Types Cache - Auto-generated by load_vm_types()"
                    echo "# @armor (Beskar Registry DNA)"
                    echo "# Version: ${_v_final_ver}"
                    echo "# DO NOT EDIT MANUALLY"
                    echo "# VM_INSTALL array is NOT cached due to shell command complexity"
                    echo ""
                    echo "typeset -gA VM_TYPE"
                    for key in "${(@k)VM_TYPE}"; do
                        value="${VM_TYPE[${key}]//'/'\\''}"
                        print -r -- "VM_TYPE[${key}]='${value}'"
                    done
                    echo ""
                    echo "typeset -gA VM_ALIASES"
                    for key in "${(@k)VM_ALIASES}"; do
                        value="${VM_ALIASES[${key}]//'/'\\''}"
                        print -r -- "VM_ALIASES[${key}]='${value}'"
                    done
                    echo ""
                    echo "typeset -gA VM_DISPLAY"
                    for key in "${(@k)VM_DISPLAY}"; do
                        value="${VM_DISPLAY[${key}]//'/'\\''}"
                        print -r -- "VM_DISPLAY[${key}]='${value}'"
                    done
                    echo ""
                    echo "typeset -gA VM_INSTALL"
                    for key in "${(@k)VM_INSTALL}"; do
                        value="${VM_INSTALL[${key}]//'/'\\''}"
                        print -r -- "VM_INSTALL[${key}]='${value}'"
                    done
                    echo ""
                    echo "typeset -gA VM_CUSTOM_CMD"
                    for key in "${(@k)VM_CUSTOM_CMD}"; do
                        value="${VM_CUSTOM_CMD[${key}]//'/'\\''}"
                        print -r -- "VM_CUSTOM_CMD[${key}]='${value}'"
                    done
                    echo ""
                    echo "typeset -gA VM_SVC_PORTS"
                    for key in "${(@k)VM_SVC_PORTS}"; do
                        value="${VM_SVC_PORTS[${key}]//'/'\\''}"
                        print -r -- "VM_SVC_PORTS[${key}]='${value}'"
                    done
                    echo ""
                    echo "typeset -gA VM_SSH_PORT"
                    for key in "${(@k)VM_SSH_PORT}"; do
                        value="${VM_SSH_PORT[${key}]//'/'\\''}"
                        print -r -- "VM_SSH_PORT[${key}]='${value}'"
                    done
                    echo ""
                    echo "typeset -gA VM_ALIAS_MAP"
                    for key in "${(@k)VM_ALIAS_MAP}"; do
                        value="${VM_ALIAS_MAP[${key}]//'/'\\''}"
                        print -r -- "VM_ALIAS_MAP[${key}]='${value}'"
                    done
                    echo ""
                    # Cache lang_vms and service_vms (use eval-safe quoting)
                    lang_vms_quoted=("${lang_vms[@]}"); echo "lang_vms=(${lang_vms_quoted[*]})"
                    service_vms_quoted=("${service_vms[@]}"); echo "service_vms=(${service_vms_quoted[*]})"
                    echo "export _VM_TYPES_LOADED=1"
                    echo "_VM_ALIAS_MAP_BUILT=1"
                } > "${cache_tmp}"
                
                mv "${cache_tmp}" "${VM_TYPES_CACHE}"
                _info "VM types cached for faster loading"
            fi
        }
        if [[ "${VDE_NO_LOCK:-0}" != "1" ]]; then
            release_lock "${global_lock}"
        fi
    else
        _info "VM types loaded from cache"
    fi

    export _VM_TYPES_LOADED=1
}

