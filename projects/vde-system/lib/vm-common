# get_allocated_ports - Get list of ports currently in use in a range
# Args: <min_port> <max_port>
# Returns: Outputs list of ports to stdout
get_allocated_ports() {
    local min_port="${1}"
    local max_port="${2}"
    local port=${min_port}
    local allocated=""

    while [[ ${port} -le ${max_port} ]]; do
        if _is_port_in_use "${port}"; then
            allocated="${allocated} ${port}"
        fi
        port=$((port + 1))
    done

    echo "${allocated# }"
}

