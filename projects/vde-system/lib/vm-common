# Check if cache is valid based on source file modification time
# Args: <cache_file> <source_file>
# Returns: 0 if cache is valid, 1 if stale
# Usage: _is_cache_valid cache_file source_file1 [source_file2 ...]
_is_cache_valid() {
    local cache_file="${1}"
    shift
    local source_files=("${@}")

    if [[ ! -f "${cache_file}" ]]; then
        return ${VDE_ERR_GENERAL}
    fi

    # Check if any source file is newer than cache
    local cache_mtime source_mtime
    if [[ "$(uname)" == "Darwin" ]]; then
        cache_mtime=$(stat -f "%m" "${cache_file}" 2>/dev/null || echo 0)
    else
        cache_mtime=$(stat -c "%Y" "${cache_file}" 2>/dev/null || echo 0)
    fi

    for source_file in "${source_files[@]}"; do
        if [[ -f "${source_file}" ]]; then
            if [[ "$(uname)" == "Darwin" ]]; then
                source_mtime=$(stat -f "%m" "${source_file}" 2>/dev/null || echo 0)
            else
                source_mtime=$(stat -c "%Y" "${source_file}" 2>/dev/null || echo 0)
            fi
            
            if [[ -n "${source_mtime}" && -n "${cache_mtime}" ]] && (( source_mtime > cache_mtime )); then
                return ${VDE_ERR_GENERAL:-1}
            fi
        fi
    done

    return 0
}

