# Create timestamped backup
# Args: <source_path>
# Returns: Outputs backup path
create_backup() {
    local source_path="${1}"

    if [[ ! -e "${source_path}" ]]; then
        return ${VDE_ERR_NOT_FOUND}
    fi

    local backup_dir="${BACKUP_DIR}/$(date +%Y%m%d-%H%M%S)"
    mkdir -p "${backup_dir}"

    local basename
    basename=$(basename "${source_path}")
    local backup_path="${backup_dir}/${basename}"

    cp -a "${source_path}" "${backup_path}"
    echo "${backup_path}"
}

