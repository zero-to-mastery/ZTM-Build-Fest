# Get port from registry
# Args: <vm_name>
# Returns: Outputs port number
get_port_from_registry() {
    local vm_name="${1}"
    local port_file="${VDE_CACHE_DIR}/port-registry/${vm_name}.port"

    if [[ -f "${port_file}" ]]; then
        cat "${port_file}"
        return ${VDE_SUCCESS}
    fi
    return ${VDE_ERR_NOT_FOUND}
}

# Save port to registry
# Args: <vm_name> <port>
save_port_to_registry() {
    local vm_name="${1}"
    local port="${2}"
    local port_dir="${VDE_CACHE_DIR}/port-registry"
    local lock_dir="${port_dir}/port-${port}.lock"

    mkdir -p "${port_dir}"
    echo "${port}" > "${port_dir}/${vm_name}.port"
    
    # Register PID in lock for concurrency hardening
    mkdir -p "${lock_dir}"
    echo "$$" > "${lock_dir}/PID"
}

# Remove port from registry
# Args: <vm_name>
remove_port_from_registry() {
    local vm_name="${1}"
    local port_file="${VDE_CACHE_DIR}/port-registry/${vm_name}.port"

    rm -f "${port_file}"
}

# Clear port registry
clear_port_registry() {
    rm -rf "${VDE_CACHE_DIR}/port-registry"
    mkdir -p "${VDE_CACHE_DIR}/port-registry"
    chmod 755 "${VDE_CACHE_DIR}/port-registry"
}

# Verify and rebuild port registry from vm-types source of truth
# Reads SSH ports from vm-types.conf/json (authoritative) and caches them
verify_port_registry() {
    # Ensure VM types are loaded (source of truth for port assignments)
    load_vm_types >/dev/null 2>&1
    
    [[ "${VDE_LOG_LEVEL:-}" == "DEBUG" ]] && _info "Verifying port registry from vm-types source"
    
    # Ensure registry dir exists
    mkdir -p "${VDE_CACHE_DIR}/port-registry"
    
    # Build port registry from VM_SSH_PORT (populated from vm-types.conf/json)
    local vm port
    for vm in ${(k)VM_SSH_PORT}; do
        port="${VM_SSH_PORT[$vm]}"
        if [[ -n "${port}" ]]; then
            save_port_to_registry "${vm}" "${port}"
            [[ "${VDE_LOG_LEVEL:-}" == "DEBUG" ]] && _info "Port registry: ${vm} -> ${port}"
        fi
    done
    
    return ${VDE_SUCCESS}
}

# release_port - Release an atomically reserved port
# Args: <port>
release_port() {
    local port="${1}"
    local lock_dir="${VDE_CACHE_DIR}/port-registry/port-${port}.lock"
    
    if [[ -d "${lock_dir}" ]]; then
        # Use rm -rf to handle STALE_HOST or other content inside the lock dir
        rm -rf "${lock_dir}"
        return ${VDE_SUCCESS}
    fi
    return ${VDE_ERR_NOT_FOUND}
}

# release_port_reservation - Alias for release_port (updated for Atomic Strategy)
# Args: <vm_name_or_port>
release_port_reservation() {
    local input="${1}"
    
    # If input is a number, it's a port
    if [[ "${input}" == [0-9]# ]]; then
        release_port "${input}"
    else
        # Find the port associated with this VM and release it
        local port
        port=$(get_port_from_registry "${input}")
        if [[ -n "${port}" ]]; then
            release_port "${port}"
            remove_port_from_registry "${input}"
        fi
    fi
}

