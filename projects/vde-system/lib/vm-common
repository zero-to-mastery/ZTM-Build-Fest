}

# vm_template_exists - Check if a VM template exists
# Args: <vm_name>
# Returns: 0 if template exists, 1 otherwise
vm_template_exists() {
    local vm_name="${1}"
    local raw_name="${vm_name#vde-}"
    local configs_dir="${VDE_CONFIGS_DIR:-${VDE_ROOT_DIR}/configs/docker}"
    
    # Check NEW category-specific path first
    local category
    category=$(get_vm_category "${vm_name}")
    if [[ "${category}" != "unknown" ]]; then
        if [[ -f "${configs_dir}/${category}/${raw_name}/docker-compose.yml" ]]; then
            return 0
        fi
    fi

    # Fallback to OLD conventional path
    if [[ -f "${configs_dir}/${raw_name}/docker-compose.yml" ]]; then
        return 0
    fi
    return ${VDE_ERR_GENERAL}
}

# vm_exists - Check if a VM has been created (alias for vm_is_created)
