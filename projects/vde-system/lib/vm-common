# resolve_vm_name - Resolve VM name or alias to canonical name
# Args: <input>
# Returns: Outputs canonical name to stdout
resolve_vm_name() {
    local input="${1}"
    
    # 1. Check as-is (canonical vde- name)
    if [[ -n "${VM_TYPE[${input}]}" ]]; then
        echo "${input}"
        return 0
    fi
    
    # 2. Check with vde- prefix if not already present
    if [[ "${input}" != vde-* ]]; then
        local prefixed="vde-${input}"
        if [[ -n "${VM_TYPE[${prefixed}]}" ]]; then
            echo "${prefixed}"
            return 0
        fi
    fi
    
    # 3. Check aliases
    for name in "${(@k)VM_ALIASES}"; do
        local aliases="${VM_ALIASES[${name}]}"
        if [[ ",${aliases}," == *",${input},"* ]]; then
            echo "${name}"
            return 0
        fi
    done
    
    # Not found
    return ${VDE_ERR_GENERAL}
}

# vde_get_hydration_script - Resolve hydration script for a VM alias or name
# Returns the absolute path to the hydration ritual from the Beskar Registry.
# Protocol: Resolves alias -> canonical name -> custom_cmd ritual.
vde_get_hydration_script() {
    local input="${1}"
    local canonical_name
    
    canonical_name=$(resolve_vm_name "${input}" 2>/dev/null) || {
        echo ""
        return ${VDE_ERR_NOT_FOUND}
    }
    
    # Extract path from custom_cmd (e.g., "zsh /vde/scripts/setup/python-init.zsh" -> "scripts/setup/python-init.zsh")
    local cmd="${VM_CUSTOM_CMD[${canonical_name}]}"
    local script_path
    
    # 1. Strip "zsh " prefix if present
    script_path="${cmd#zsh }"
    # 2. Strip "/vde/" root if present (internal jails map root to /vde/)
    script_path="${script_path#/vde/}"
    
    # 3. If it is an absolute path on the host, return it. 
    # Otherwise, resolve against VDE_ROOT_DIR.
    if [[ "${script_path}" != /* ]]; then
        script_path="${VDE_ROOT_DIR}/${script_path}"
    fi

    echo "${script_path}"
    return 0
}

