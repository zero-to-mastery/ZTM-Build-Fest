# PORT ALLOCATION
# =============================================================================

# find_next_available_port - Find next available port for VM type
# Args: <vm_type>
# Returns: VDE_SUCCESS (0) and outputs port to stdout
find_next_available_port() {
    local vm_type="${1}"
    local min_port max_port

    if [[ "${vm_type}" = "lang" ]]; then
        min_port=${VDE_LANG_PORT_START}
        max_port=${VDE_LANG_PORT_END}
    else
        min_port=${VDE_SVC_PORT_START}
        max_port=${VDE_SVC_PORT_END}
    fi

    local port
    port=$(find_available_port "${min_port}" "${max_port}")
    
    if [[ ${?} -eq 0 ]] && [[ -n "${port}" ]]; then
        echo "${port}"
        return ${VDE_SUCCESS}
    fi
    return ${VDE_ERR_GENERAL}
}

# Find available port in range (Atomic Reservation Strategy VDE v2.0.6 Hardened)
# Args: [min_port] [max_port] [exclude_ports_str]
# Returns: Outputs port number
find_available_port() {
    local min_port=$1
    local max_port=$2
    local registry_dir="${VDE_CACHE_DIR}/port-registry"
    
    mkdir -p "${registry_dir}"
    
    local port=${min_port}
    while [[ ${port} -le ${max_port} ]]; do
        # Atomic Reservation: mkdir is atomic across processes
        if mkdir "${registry_dir}/port-${port}.lock" 2>/dev/null; then
            
            # THE SEEKER'S RECON (Section 10.3): Hardened Physical Handshake
            # 1. Dynamic Identity: Prevent name collisions on Darwin
            local probe_name="vde-recon-probe-${port}-${RANDOM}"
            
            # 2. Resource Jitter (Section 11.2): Allow Docker-on-macOS socket to breathe
            local jitter_val=$(( (RANDOM % 20) + 10 ))
            zmodload zsh/zselect 2>/dev/null && zselect -t ${jitter_val}
            
            # 3. Sovereign Timeout (3s Strike): Prevent hangs on port conflict
            if [[ "${VDE_CI_MODE:-0}" == "1" ]]; then
                # In CI mode, we assume the port is clear if we got the lock
                # (We can't reliably run containers in many CI environments)
                echo "${port}"
                return 0
            fi

            ( docker run --rm --name "${probe_name}" --entrypoint /bin/true -p "${port}:22" vde-base >/dev/null 2>&1 ) & local _probe_pid=$!
            ( zmodload zsh/zselect 2>/dev/null && zselect -t 300 2>/dev/null; kill -9 $_probe_pid 2>/dev/null ) & local _timer_pid=$!
            
            wait $_probe_pid
            local _probe_rc=$?
            kill -9 $_timer_pid 2>/dev/null
            
            # 4. Sentinel Audit (Section 12): Purge ephemeral spirit
            docker rm -f "${probe_name}" >/dev/null 2>&1
            
            if [[ $_probe_rc -ne 0 ]]; then
                # Port is a Ghost or occupied by Scavengers
                touch "${registry_dir}/port-${port}.lock/STALE_HOST"
                # Keep the lock to prevent others from retrying this failed port immediately
                port=$((port + 1))
                continue
            fi
            
            # Port is verified clear.
            echo "${port}"
            return 0
        fi
        port=$((port + 1))
    done
    return 1
}

# Allocate port for VM
# Args: <vm_name> [min_port] [max_port] [exclude_ports_str]
# Returns: Outputs port number
allocate_port_for_vm() {
    local vm_name="${1}"
    local min_port="${2:-2200}"
    local max_port="${3:-2299}"
    local exclude_ports_str="${4}"

    local existing_port
    existing_port=$(get_port_from_registry "${vm_name}")

    if [[ -n "${existing_port}" ]]; then
        # If port is already in registry, respect it, unless it's in the exclusion list
        if [[ -z "${exclude_ports_map[${existing_port}]}" ]]; then
            echo "${existing_port}"
            return ${VDE_SUCCESS}
        fi
    fi

    # New logic: check VM_SSH_PORT (pre-assigned)
    load_vm_types >/dev/null 2>&1
    local pre_assigned_port="${VM_SSH_PORT[${vm_name}]}"
    if [[ -n "${pre_assigned_port}" ]] && [[ "${pre_assigned_port}" -ge "${min_port}" ]] && [[ "${pre_assigned_port}" -le "${max_port}" ]] && ! _is_port_in_use "${pre_assigned_port}"; then
        if [[ -z "${exclude_ports_map[${pre_assigned_port}]}" ]]; then
            save_port_to_registry "${vm_name}" "${pre_assigned_port}"
            echo "${pre_assigned_port}"
            return ${VDE_SUCCESS}
        fi
    fi

    local new_port
    new_port=$(find_available_port "${min_port}" "${max_port}" "${exclude_ports_str}")

    if [[ -z "${new_port}" ]]; then
        return ${VDE_ERR_NO_PORT}
    fi

    save_port_to_registry "${vm_name}" "${new_port}"
    echo "${new_port}"
}

# Get or allocate port for VM
# Args: <vm_name>
# Returns: Outputs port number
get_or_allocate_port() {
    local vm_name="${1}"
    local vm_type
    vm_type=$(get_vm_type "${vm_name}")

    local min_port max_port
    case "${vm_type}" in
        lang)
            min_port=${VDE_LANG_PORT_START}
            max_port=${VDE_LANG_PORT_END}
            ;;
        service)
            min_port=${VDE_SVC_PORT_START}
            max_port=${VDE_SVC_PORT_END}
            ;;
        *)
            min_port=${VDE_LANG_PORT_START}
            max_port=${VDE_SVC_PORT_END}
            ;;
    esac

    allocate_port_for_vm "${vm_name}" "${min_port}" "${max_port}"
}

