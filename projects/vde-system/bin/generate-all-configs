#!/usr/bin/env zsh
# @armor (Engine Core)
#===============================================================================
# generate-all-configs - Sovereign Config Smelter
# Version: 2.1.0 (Direct-Access Optimization)
#
# Optimized for Phase 31: DNS Discovery & Bridge expansion.
# Eliminating subshell overhead for maximum technical integrity.
#===============================================================================

set -e

# Establish context
# Use zsh-native absolute path detection (Rule 1)
VDE_ROOT_DIR="${0:h:h}"
export VDE_ROOT_DIR

# Source libraries
source "${VDE_ROOT_DIR}/lib/vde-shell-compat"
source "${VDE_ROOT_DIR}/lib/vde-constants"
source "${VDE_ROOT_DIR}/lib/vde-log"
source "${VDE_ROOT_DIR}/lib/vde-naming"
source "${VDE_ROOT_DIR}/lib/vm-common"
source "${VDE_ROOT_DIR}/lib/vde-templates"

# Parse arguments
FORCE=false
[[ "$1" == "--force" || "$1" == "-f" ]] && FORCE=true

#===============================================================================
# Smelting Logic
#===============================================================================

smelt_vm_configs() {
    local category="${1}"
    local -a vms
    
    if [[ "${category}" == "languages" ]]; then
        vms=("${lang_vms[@]}")
    else
        vms=("${service_vms[@]}")
    fi

    for vm_name in "${vms[@]}"; do
        local short_name="${vm_name#vde-}"
        local config_dir="${VDE_ROOT_DIR}/configs/docker/${category}/${short_name}"
        local compose_file="${config_dir}/docker-compose.yml"
        local env_file="${VDE_ROOT_DIR}/env-files/${short_name}.env"

        if [[ "${FORCE}" == "false" && -f "${compose_file}" && -f "${env_file}" ]]; then
            continue
        fi

        mkdir -p "${config_dir}"

        # 1. Smelt docker-compose.yml (Direct Array Access)
        local ssh_port="${VM_SSH_PORT[${vm_name}]}"
        local svc_ports="${VM_SVC_PORTS[${vm_name}]}"
        local pkgs="${VM_INSTALL[${vm_name}]}"
        local custom_cmd="${VM_CUSTOM_CMD[${vm_name}]}"

        local manifest
        if [[ "${category}" == "languages" ]]; then
            manifest=$(render_language_template "${short_name}" "${ssh_port}" "${custom_cmd}")
            manifest="${manifest//\{\{PKGS\}\}/${pkgs}}"
        else
            manifest=$(render_service_template "${short_name}" "${ssh_port}" "${svc_ports}" "${custom_cmd}")
            manifest="${manifest//\{\{PKGS\}\}/${pkgs}}"
        fi
        
        echo "${manifest}" > "${compose_file}"

        # 2. Smelt environment file
        {
            echo "# Spoke Environment"
            echo "# @armor (Spoke Environment)"
            echo "# Auto-generated by generate-all-configs"
            echo "SSH_PORT=${ssh_port}"
            echo "DATABASE_URL=postgresql://devuser:\${POSTGRES_DEV_PASSWORD:-vde_dev_pass}@postgres:5432/${short_name}_dev_db"
            echo "REDIS_HOST=redis"
            echo "REDIS_PORT=6379"
            echo "VDE_HOST=vde-host"
            
            if [[ "${category}" == "services" && -n "${svc_ports}" ]]; then
                local upper_name="${(U)short_name}"
                for p in ${(s:,:)svc_ports}; do
                    p="${p// /}" # Zsh-native space removal
                    [[ "${short_name}" == "rabbitmq" ]] && echo "RABBITMQ_PORT=${p}" || echo "${upper_name}_PORT=${p}"
                done
            fi
        } > "${env_file}"

        vde_log_info "Forged: ${short_name} (${category})" "smelter"
    done
}

main() {
    vde_log_info "Initiating Sovereign Configuration Smelting..." "smelter"
    
    # Ensure types are loaded in this shell process
    load_vm_types

    # Strike the metal
    smelt_vm_configs "languages"
    smelt_vm_configs "services"

    # 3. Smelt SSH Configuration
    vde_log_info "Syncing SSH Pillar..." "ssh"
    local ssh_config="${VDE_ROOT_DIR}/configs/ssh/config"
    local spoke_config="${VDE_ROOT_DIR}/configs/ssh/config.spoke"
    local current_version=$(vde_get_version)
    
    local header="# VDE SSH Configuration
# Sovereign Baseline: ${current_version}
# DO NOT EDIT MANUALLY
"
    
    echo "${header}" > "${ssh_config}"
    echo "${header}" > "${spoke_config}"

    for vm_name in "${lang_vms[@]}" "${service_vms[@]}"; do
        local port="${VM_SSH_PORT[${vm_name}]}"
        if [[ -n "${port}" ]]; then
            # Hub Config: uses 'localhost'
            render_ssh_entry "${vm_name}" "${port}" "localhost" >> "${ssh_config}"
            # Spoke Config: uses container name (e.g., vde-python)
            local container_name=$(vde_get_ssh_host "${vm_name}")
            render_ssh_entry "${vm_name}" "${port}" "${container_name}" >> "${spoke_config}"
        fi
    done
    
    chmod 600 "${ssh_config}" "${spoke_config}"
    vde_log_success "Sovereign Configuration Smelted Successfully." "smelter"
}

main "$@"
