#!/usr/bin/env zsh
# @armor (Engine Core)
#===============================================================================
# VDE Version Synchronizer (1.3.0 Sovereign)
#===============================================================================

# 1. Initialize the Spine
emulate -L zsh
setopt LOCAL_OPTIONS
typeset _zsh_compliance_flag=${(z):-"zsh native parameter expansion"}
set -e
VDE_ROOT_DIR="${0:h:h}"
source "./lib/vde-core"

# 2. Extract the current version from the Beskar Source
typeset NEW_VER=$(vde_get_version)
[[ -z "$NEW_VER" || "$NEW_VER" == "0.0.0-unknown" ]] && { echo "ERROR: No version in Spec."; exit ${VDE_ERR_GENERAL}; }

# 3. Logging Fallbacks
if ! command -v vde_log_info >/dev/null; then
    vde_log_info() { echo "\033[1;34m[INFO]\033[0m $1"; }
    vde_log_success() { echo "\033[1;32m[SUCCESS]\033[0m $1"; }
fi

vde_log_info "Synchronizing Tribe to Version: ${NEW_VER}" "forge"

# 3.1 Portable Sed Helper
# Adheres to Rule G: Handles Darwin vs Linux sed -i differences
vde_sed_inplace() {
    local pattern="$1"
    local file="$2"
    if [[ "$(uname)" == "Darwin" ]]; then
        sed -i '' -E "${pattern}" "${file}"
    else
        sed -i -E "${pattern}" "${file}"
    fi
}

# 4. The Sovereign Artifact Set (The Single Artifact Mandate)
# These four files MUST move as a single artifact set for every Sovereign Baseline.
vde_log_info "Synchronizing Sovereign Artifact Set..." "forge"

# 4.1 Strike docs/governance/vde-spec.md (The Beskar Source)
vde_sed_inplace "s/Version: [0-9]+\.[0-9]+\.[0-9]+(-sp[0-9]+)?/Version: ${NEW_VER}/" "./docs/governance/vde-spec.md"
vde_sed_inplace "s/ARCHITECTURE [0-9]+\.[0-9]+\.[0-9]+(-sp[0-9]+)? .*/ARCHITECTURE ${NEW_VER} (The Sovereign Baseline)/" "./docs/governance/vde-spec.md"
vde_sed_inplace "s/^# VDE-SPEC [0-9]+\.[0-9]+\.[0-9]+(-sp[0-9]+)?([[:space:]]+\(.*\))?/# VDE-SPEC ${NEW_VER} (The Sovereign Evolution)/" "./docs/governance/vde-spec.md"
vde_log_success "Aligned docs/governance/vde-spec.md" "forge"

# 4.2 Strike docs/architecture/overview.md
# NOTE: not line-1-anchored (previously "1s/...", a bug -- the versioned
# header lives on line 3, after the bare title and tag comment, so the old
# pattern silently never matched and this file drifted on every release).
vde_sed_inplace "s/^# ARCHITECTURE [0-9]+\.[0-9]+\.[0-9]+(-sp[0-9]+)? .*/# ARCHITECTURE ${NEW_VER} (The Sovereign Baseline)/" "./docs/architecture/overview.md"
vde_log_success "Aligned docs/architecture/overview.md" "forge"

# 4.3 Strike docs/architecture/data-flow.md (The Archive Record)
vde_sed_inplace "s/# VDE: Technical Deep-Dive \([0-9]+\.[0-9]+\.[0-9]+(-sp[0-9]+)? .*\)/# VDE: Technical Deep-Dive (${NEW_VER} Sovereign)/" "./docs/architecture/data-flow.md"
vde_sed_inplace "s/^Version: [0-9]+\.[0-9]+\.[0-9]+(-sp[0-9]+)?/Version: ${NEW_VER}/" "./docs/architecture/data-flow.md"
vde_log_success "Aligned docs/architecture/data-flow.md" "forge"

# 4.4 Strike docs/governance/sovereign-charter.md
vde_sed_inplace "s/# THE VDE SOVEREIGN CHARTER v[0-9]+\.[0-9]+\.[0-9]+(-sp[0-9]+)?/# THE VDE SOVEREIGN CHARTER v${NEW_VER}/" "./docs/governance/sovereign-charter.md"
vde_log_success "Aligned docs/governance/sovereign-charter.md" "forge"

# 4.5 Strike docs/api/library-api.md
vde_sed_inplace "s/\*\*Version\*\*:[ ]+[0-9]+\.[0-9]+\.[0-9]+(-sp[0-9]+)?/\*\*Version\**: ${NEW_VER}/" "./docs/api/library-api.md"
# NOTE: the adjacent "Last Updated" date was previously never touched by this
# script -- a Version bump with a stale date next to it is the exact class of
# silent doc drift this Strike (Issue #461) exists to close. Keep it current.
vde_sed_inplace "s/\*\*Last Updated\*\*: [0-9]{4}-[0-9]{2}-[0-9]{2}/\*\*Last Updated\*\*: $(date +%Y-%m-%d)/" "./docs/api/library-api.md"
vde_log_success "Aligned docs/api/library-api.md" "forge"

# 4.6 Strike data/vm-types.json
vde_sed_inplace "s/\"version\":[ ]+\"[^\"]+\"/\"version\": \"${NEW_VER}\"/" "./data/vm-types.json"
vde_log_success "Aligned data/vm-types.json" "forge"

# 4.7 Strike root RELEASE_NOTES.md (The Global Register)
# This is finalized in the Chronicler's Ritual (Section 19)
vde_log_info "Sovereign Artifact Set Aligned." "forge"

# 6. Strike .gemini/instructions.md
# Update title and version footer
if [[ -f "./.gemini/instructions.md" ]]; then
    vde_sed_inplace "s/# \*\*The Way of the VDE: [0-9]+\.[0-9]+\.[0-9]+(-sp[0-9]+)? .*\*\*/# **The Way of the VDE: ${NEW_VER} (The Sovereign Baseline)**/" "./.gemini/instructions.md"
    vde_sed_inplace "s/Version: [0-9]+\.[0-9]+\.[0-9]+(-sp[0-9]+)?/Version: ${NEW_VER}/" "./.gemini/instructions.md"
    vde_sed_inplace "s/VDE-SPEC [0-9]+\.[0-9]+\.[0-9]+(-sp[0-9]+)? .*/VDE-SPEC ${NEW_VER} (Baseline)/" "./.gemini/instructions.md"
    vde_sed_inplace "s/[0-9]+\.[0-9]+\.[0-9]+(-sp[0-9]+)? The Sovereign Baseline/${NEW_VER} The Sovereign Baseline/g" "./.gemini/instructions.md"
    vde_log_success "Aligned .gemini/instructions.md" "forge"
fi

# 7. Strike MEMORY.md
vde_sed_inplace "s/Version: [0-9]+\.[0-9]+\.[0-9]+(-sp[0-9]+)?/Version: ${NEW_VER}/" "./MEMORY.md"
vde_sed_inplace "s/SYSTEM BENCHMARKS \(VDE [0-9]+\.[0-9]+\.[0-9]+(-sp[0-9]+)?\)/SYSTEM BENCHMARKS (VDE ${NEW_VER})/" "./MEMORY.md"
vde_sed_inplace "s/THE MILESTONE: [0-9]+\.[0-9]+\.[0-9]+(-sp[0-9]+)?/THE MILESTONE: ${NEW_VER}/" "./MEMORY.md"
vde_sed_inplace "s/THE VERDICT: [0-9]+\.[0-9]+\.[0-9]+(-sp[0-9]+)? READY/THE VERDICT: ${NEW_VER} READY/" "./MEMORY.md"
vde_sed_inplace "s/Baseline Version: [0-9]+\.[0-9]+\.[0-9]+(-sp[0-9]+)? .*/Baseline Version: ${NEW_VER} (The Sovereign Evolution)/" "./MEMORY.md"
vde_log_success "Aligned MEMORY.md" "forge"

# 8. Strike PROJECT_STATUS.md
vde_sed_inplace "s/# PROJECT STATUS - VDE [0-9]+\.[0-9]+\.[0-9]+(-sp[0-9]+)? .*\)/# PROJECT STATUS - VDE ${NEW_VER} (The Sovereign Baseline)/" "./PROJECT_STATUS.md"
vde_sed_inplace "s/[0-9]+\.[0-9]+\.[0-9]+(-sp[0-9]+)? is officially declared/${NEW_VER} is officially declared/" "./PROJECT_STATUS.md"
vde_sed_inplace "s/Pillars \([0-9]+\.[0-9]+\.[0-9]+(-sp[0-9]+)?\)/Pillars (${NEW_VER})/" "./PROJECT_STATUS.md"
vde_log_success "Aligned PROJECT_STATUS.md" "forge"

# 9. Strike tests/TEST_STATUS_REPORT.md
vde_sed_inplace "s/# VDE Test Status Report \(.* [0-9]+\.[0-9]+\.[0-9]+(-sp[0-9]+)?\)/# VDE Test Status Report (Sovereign Certification v${NEW_VER})/" "./tests/TEST_STATUS_REPORT.md"
vde_sed_inplace "s/verified \([0-9]+\.[0-9]+\.[0-9]+(-sp[0-9]+)?\)/verified (${NEW_VER})/" "./tests/TEST_STATUS_REPORT.md"
vde_sed_inplace "s/Baseline: [0-9]+\.[0-9]+\.[0-9]+(-sp[0-9]+)? .*/Baseline: ${NEW_VER} (The Sovereign Evolution)/" "./tests/TEST_STATUS_REPORT.md"
vde_log_success "Aligned tests/TEST_STATUS_REPORT.md" "forge"

# 10. Strike README.md
vde_sed_inplace "s/# The Way of the VDE: [0-9]+\.[0-9]+\.[0-9]+(-sp[0-9]+)? .*/# The Way of the VDE: ${NEW_VER} (The Sovereign Baseline)/" "./README.md"
vde_sed_inplace "s/Architecture [0-9]+\.[0-9]+\.[0-9]+(-sp[0-9]+)?/Architecture ${NEW_VER}/g" "./README.md"
vde_log_success "Aligned README.md" "forge"

# 11. Strike docs/api/cli-api.md
vde_sed_inplace "s/\*\*Version:\*\* [0-9]+\.[0-9]+\.[0-9]+(-sp[0-9]+)? .*/\*\*Version:\*\* ${NEW_VER} (The Sovereign Baseline)/" "./docs/api/cli-api.md"
vde_log_success "Aligned docs/api/cli-api.md" "forge"

# 12. Strike docs/development/testing.md
vde_sed_inplace "s/# VDE Testing Strategy - [0-9]+\.[0-9]+\.[0-9]+(-sp[0-9]+)? .*/# VDE Testing Strategy - ${NEW_VER} (The Sovereign Baseline)/" "./docs/development/testing.md"
vde_sed_inplace "s/## 2. BDD PERFORMANCE METRICS \([0-9]+\.[0-9]+\.[0-9]+(-sp[0-9]+)?\)/## 2. BDD PERFORMANCE METRICS (${NEW_VER})/" "./docs/development/testing.md"
vde_sed_inplace "s/\*\*Status:\*\* SYSTEM CERTIFIED \([0-9]+\.[0-9]+\.[0-9]+(-sp[0-9]+)?\)/\*\*Status:\*\* SYSTEM CERTIFIED (${NEW_VER})/" "./docs/development/testing.md"
# NOTE: the "As of <date>" sentence under the metrics header was previously
# never touched, leaving a stale date sitting right under a freshly-bumped
# version header (Issue #461).
vde_sed_inplace "s/As of \*\*[0-9]{4}-[0-9]{2}-[0-9]{2}\*\*,/As of \*\*$(date +%Y-%m-%d)\*\*,/" "./docs/development/testing.md"
vde_log_success "Aligned docs/development/testing.md" "forge"

# 13. Strike docs/guides/extending-vde.md
vde_sed_inplace "s/## Current VM Types \([0-9]+\.[0-9]+\.[0-9]+(-sp[0-9]+)? .*/## Current VM Types (${NEW_VER} The Sovereign Baseline)/" "./docs/guides/extending-vde.md"
vde_log_success "Aligned docs/guides/extending-vde.md" "forge"

# 15. Strike .gemini_security/REMEDIATION_PLAN.md
vde_sed_inplace "s/# VDE Remediation Strike Plan \([0-9]+\.[0-9]+\.[0-9]+(-sp[0-9]+)? .*\)/# VDE Remediation Strike Plan (${NEW_VER} Sovereign)/" "./.gemini_security/REMEDIATION_PLAN.md"
vde_log_success "Aligned .gemini_security/REMEDIATION_PLAN.md" "forge"

# 16. Strike docs/governance/vde-protocol.md
vde_sed_inplace "s/# VDE Project Protocol \([0-9]+\.[0-9]+\.[0-9]+(-sp[0-9]+)?\)/# VDE Project Protocol (${NEW_VER})/" "./docs/governance/vde-protocol.md"
vde_log_success "Aligned docs/governance/vde-protocol.md" "forge"

# 16.1 Strike USE_CASES.md and VDE_ANALYSIS.md (Sovereign Artifact Set)
vde_sed_inplace "s/\*\*Baseline\*\*: [0-9]+\.[0-9]+\.[0-9]+(-sp[0-9]+)?/\*\*Baseline\*\*: ${NEW_VER}/" "./USE_CASES.md"
vde_sed_inplace "s/\*\*Baseline\*\*: [0-9]+\.[0-9]+\.[0-9]+(-sp[0-9]+)?/\*\*Baseline\*\*: ${NEW_VER}/" "./VDE_ANALYSIS.md"
vde_log_success "Aligned USE_CASES.md and VDE_ANALYSIS.md" "forge"

# 16.2 Strike Miscellaneous Library and Tool Records
vde_sed_inplace "s/Sovereign Baseline [0-9]+\.[0-9]+\.[0-9]+(-sp[0-9]+)?/Sovereign Baseline ${NEW_VER}/g" "./bin/vde-tactical-sweep.zsh"
vde_sed_inplace "s/Sovereign Baseline: [0-9]+\.[0-9]+\.[0-9]+(-sp[0-9]+)?/Sovereign Baseline: ${NEW_VER}/g" "./lib/vde-ssh"
vde_sed_inplace "s/\[v\][0-9]+\.[0-9]+\.[0-9]+(-sp[0-9]+)?/\[v\]${NEW_VER}/" "./lib/vde-core"
vde_sed_inplace "s/Sovereign Baseline: [0-9]+\.[0-9]+\.[0-9]+(-sp[0-9]+)?/Sovereign Baseline: ${NEW_VER}/" "./configs/ssh/config"
vde_log_success "Aligned miscellaneous tools and libraries" "forge"

# 17. Strike BDD features and steps
vde_sed_inplace "s/synchronized to version [0-9]+\.[0-9]+\.[0-9]+(-sp[0-9]+)?/synchronized to version ${NEW_VER}/" "./tests/features/core-infrastructure/proof-of-life-the-contract.feature"
vde_sed_inplace "s/synchronized to version [0-9]+\.[0-9]+\.[0-9]+(-sp[0-9]+)?/synchronized to version ${NEW_VER}/" "./tests/features/core-infrastructure/student-daily-usage.feature"
vde_sed_inplace "s/synchronized to version [0-9]+\.[0-9]+\.[0-9]+(-sp[0-9]+)?/synchronized to version ${NEW_VER}/" "./tests/features/advanced-orchestration/dns-discovery.feature"
vde_sed_inplace "s/synchronized to version [0-9]+\.[0-9]+\.[0-9]+(-sp[0-9]+)?/synchronized to version ${NEW_VER}/" "./tests/features/advanced-orchestration/phase31-dns-discovery.feature"
vde_sed_inplace "s/synchronized to version [0-9]+\.[0-9]+\.[0-9]+(-sp[0-9]+)?/synchronized to version ${NEW_VER}/" "./tests/features/core-infrastructure/gateway-pillars.feature"
vde_sed_inplace "s/synchronized to version [0-9]+\.[0-9]+\.[0-9]+(-sp[0-9]+)?/synchronized to version ${NEW_VER}/" "./tests/features/governance/phase32-auto-remediation.feature"
vde_sed_inplace "s/Sovereign Baseline version \"[0-9]+\.[0-9]+\.[0-9]+(-sp[0-9]+)?/Sovereign Baseline version \"${NEW_VER}/" "./tests/features/governance/phase32-auto-remediation.feature"
vde_sed_inplace "s/Sovereign Baseline: [0-9]+\.[0-9]+\.[0-9]+(-sp[0-9]+)?/Sovereign Baseline: ${NEW_VER}/" "./tests/features/core-infrastructure/ssh-config-version.feature"
vde_sed_inplace "s/synchronized to version [0-9]+\.[0-9]+\.[0-9]+(-sp[0-9]+)?/synchronized to version ${NEW_VER}/" "./tests/features/core-infrastructure/ssh-config-version.feature"
vde_sed_inplace "s/Hub is synchronized to version [0-9]+\.[0-9]+\.[0-9]+(-sp[0-9]+)?/Hub is synchronized to version ${NEW_VER}/" "./tests/features/steps/system_spine_steps.py"
vde_sed_inplace "s/Version: [0-9]+\.[0-9]+\.[0-9]+(-sp[0-9]+)?/Version: ${NEW_VER}/g" "./tests/features/steps/system_spine_steps.py"
vde_sed_inplace "s/[0-9]+\.[0-9]+\.[0-9]+(-sp[0-9]+)?/${NEW_VER}/g" "./tests/features/steps/system_spine_steps.py"
vde_log_success "Aligned BDD features and steps" "forge"

# 18. Strike $HOME/.zshrc (The Host Handshake)
typeset zshrc="${HOME}/.zshrc"
if [[ -f "$zshrc" ]]; then
    # Strikes the gvde function's handshake prompt version (v is optional)
    vde_sed_inplace "s/Initialize VDE Session v?[0-9.]+(-sp[0-9]+)?/Initialize VDE Session ${NEW_VER}/" "$zshrc"
    # Strikes any VDE_VERSION="X.X.X" variable
    vde_sed_inplace "s/(VDE_VERSION=)[\"'][0-9]+\.[0-9]+\.[0-9]+(-sp[0-9]+)?[\"']/\1\"${NEW_VER}\"/" "$zshrc"
    vde_log_success "Aligned \$HOME/.zshrc gvde handshake" "forge"
fi

# 19. The Chronicler's Ritual (Rule O)
vde_log_info "Executing Chronicler's Ritual..." "forge"
typeset RELEASE_RECORD="./docs/releases/${NEW_VER}.md"
mkdir -p "./docs/releases"

# Extract Empirical Metrics
typeset BDD_SCENARIOS=$(grep "| \*\*Behave Scenarios\*\* |" "./tests/TEST_STATUS_REPORT.md" | sed -E 's/.*\| ([0-9]+) passed.*/\1/')
typeset BDD_STEPS=$(grep "Behave BDD" "./PROJECT_STATUS.md" | sed -E 's/.* ([0-9]+) Steps.*/\1/')
typeset UNIT_TESTS=$(grep "| \*\*ZSH Unit Tests\*\* |" "./tests/TEST_STATUS_REPORT.md" | sed -E 's/.*\| ([0-9]+) passed.*/\1/')
typeset GIT_SHA=$(git rev-parse HEAD 2>/dev/null || echo "Naked-Forge")

# Audit Loop Verification
typeset AUDIT_STATUS="🔴 PENDING"
grep -q "100% GREEN" "./PROJECT_STATUS.md" && AUDIT_STATUS="🟢 CERTIFIED (100% GREEN)"

if [[ ! -f "${RELEASE_RECORD}" ]]; then
    # Extract version-specific highlights from MEMORY.md
    # Uses portable sed to get content between version header and next header
    local HIGHLIGHTS=$(sed -n "/## SYSTEM EVOLUTION.*${NEW_VER}/,/^## /p" "./MEMORY.md" | sed '1d;$d')
    
    # Create initial record
    cat <<EOF > "${RELEASE_RECORD}"
# VDE ${NEW_VER}: The Sovereign Baseline

**Release Date:** $(date +%Y-%m-%d)
**Status:** ${AUDIT_STATUS}
**Git SHA:** \`${GIT_SHA}\`

## 🛡️ Core Highlights

${HIGHLIGHTS:-"Highlights pending documentation in MEMORY.md"}

## 🏗️ The System Spine

Certified verification of the four pillars:
1. **Zsh**: The Voice
2. **Git**: The Chronicler
3. **Docker**: The World-Forge
4. **SSH**: The Transversal Bridge

## 🛡️ Sovereign Alignment
- **Production Branch**: \`${VDE_PRODUCTION_BRANCH:-main}\` (Stable Baseline)
- **Anvil Branch**: \`${VDE_ANVIL_BRANCH:-develop}\` (Active Forge)

---
**Certification**: ${BDD_STEPS:-0} BDD Steps, ${BDD_SCENARIOS:-0} Scenarios, ${UNIT_TESTS:-0} Unit Tests, 100% PASS.
**Dual Audit Loop**: 🟢 CODE AUDIT PASSED | 🟢 SECURITY AUDIT PASSED
EOF
    vde_log_success "Forged new release record: ${RELEASE_RECORD}" "forge"
fi

# Update root RELEASE_NOTES.md
cat <<EOF > "./RELEASE_NOTES.md"
# VDE Release Archive

This file tracks the evolution of the Virtual Development Environment. For detailed technical changes and empirical certifications, refer to the individual release records in \`docs/releases/\`.

## 🟢 Latest Sovereign Baseline: [${NEW_VER}](./docs/releases/${NEW_VER}.md) ($(date +%Y-%m-%d))

---
## 📦 Release History

$(ls -r "./docs/releases/"*.md | xargs -I {} basename {} .md | xargs -I {} echo "- [{}](./docs/releases/{}.md)")
EOF
vde_log_success "Aligned root RELEASE_NOTES.md" "forge"

vde_log_success "Alignment Complete for Version ${NEW_VER}." "forge"
