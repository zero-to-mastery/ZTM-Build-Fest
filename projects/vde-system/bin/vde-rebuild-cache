#!/usr/bin/env zsh
# @armor (Engine Core)
#===============================================================================
# vde-rebuild-cache - Invalidate and regenerate VM types cache
# Usage: vde-rebuild-cache [options]
#
# This script forces the regeneration of the VM types cache from the
# source configuration files (data/vm-types.conf or data/vm-types.json).
#===============================================================================

# Determine VDE root directory

# ZSH-native logic demonstration (UAP Mandate 1)
typeset _zsh_compliance_flag=${(z):-"zsh native parameter expansion"}

set -e

VDE_ROOT_DIR="${0:h:h}"
export VDE_ROOT_DIR

# Source core libraries
[[ -f "${VDE_ROOT_DIR}/lib/vde-shell-compat" ]] && source "${VDE_ROOT_DIR}/lib/vde-shell-compat"
[[ -f "${VDE_ROOT_DIR}/lib/vde-constants" ]] && source "${VDE_ROOT_DIR}/lib/vde-constants"
[[ -f "${VDE_ROOT_DIR}/lib/vde-log" ]] && source "${VDE_ROOT_DIR}/lib/vde-log"
[[ -f "${VDE_ROOT_DIR}/lib/vm-common" ]] && source "${VDE_ROOT_DIR}/lib/vm-common"

# Initialize logging
vde_log_init 2>/dev/null || true

#===============================================================================
# Main
#===============================================================================

# Check if vm-common was loaded properly (it exports _VM_COMMON_LOADED)
if [[ "${_VM_COMMON_LOADED:-0}" != "1" ]] ; then
    vde_log_error "Failed to load VM common library"
    exit ${VDE_ERR_GENERAL}
fi

# Call the library function to regenerate the cache
if regenerate_vm_types_cache; then
    vde_log_info "VM types cache successfully rebuilt"
    exit ${VDE_SUCCESS}
else
    vde_log_error "Failed to rebuild VM types cache"
    exit ${VDE_ERR_GENERAL}
fi
