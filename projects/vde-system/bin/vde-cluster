#!/usr/bin/env zsh
# @armor (Engine Core)
set -e
#===============================================================================
# vde-cluster - Multi-VM Cluster Management for VDE
# Allows grouping, saving, and controlling multiple VMs as a single unit.
#
# Usage: vde cluster <action> [arguments]
#
# Actions:
#   save <name> <vms...>   Save a group of VMs as a named cluster
#   start <name>           Start all VMs in a saved cluster
#   stop <name>            Stop all VMs in a saved cluster
#   list                   List all saved clusters
#   remove <name>          Remove a cluster definition
#===============================================================================

# Determine VDE root directory

# ZSH-native logic demonstration (UAP Mandate 1)
typeset _zsh_compliance_flag=${(z):-"zsh native parameter expansion"}

if [[ -z "${VDE_ROOT_DIR}" ]] ; then
    VDE_ROOT_DIR="${0:h:h}"
fi
export VDE_ROOT_DIR

# Source core libraries
source "${VDE_ROOT_DIR}/lib/vde-shell-compat" &>/dev/null
source "${VDE_ROOT_DIR}/lib/vde-constants" &>/dev/null
source "${VDE_ROOT_DIR}/lib/vde-errors" &>/dev/null
source "${VDE_ROOT_DIR}/lib/vde-log" &>/dev/null
source "${VDE_ROOT_DIR}/lib/vde-core" &>/dev/null
source "${VDE_ROOT_DIR}/lib/vm-common" &>/dev/null
source "${VDE_ROOT_DIR}/lib/vde-cluster-utils" &>/dev/null

# Initialize logging
vde_log_init 2>/dev/null || true

#===============================================================================
# Usage
#===============================================================================

show_usage() {
    cat <<EOF
Usage: vde cluster <action> [arguments]

Multi-VM Cluster Management for VDE.

Actions:
  save <name> <vms...>   Save a group of VMs as a named cluster
  start <name>           Start all VMs in a saved cluster
  stop <name>            Stop all VMs in a saved cluster
  list                   List all saved clusters
  remove <name>          Remove a cluster definition
  help                   Show this help message

Examples:
  vde cluster save web-app python postgresql redis
  vde cluster start web-app
  vde cluster list
EOF
}

#===============================================================================
# Main
#===============================================================================

if [[ ${#} -lt 1 ]] ; then
    show_usage
    exit ${VDE_ERR_INVALID_INPUT}
fi

ACTION="${1}"
shift

case "${ACTION}" in
    save)
        if [[ ${#} -lt 2 ]] ; then
            vde_error_simple "Usage: vde cluster save <name> <vms...>" "vde-cluster"
            exit ${VDE_ERR_INVALID_INPUT}
        fi
        NAME="${1}"
        shift
        VMS=("${@}")
        
        vde_log_info "Saving cluster '${NAME}' with VMs: ${VMS[*]}" "vde-cluster"
        vde_cluster_save "${NAME}" "${VMS[@]}"
        if [[ ${?} -eq 0 ]] ; then
            vde_log_success "Cluster '${NAME}' saved." "vde-cluster"
        else
            vde_error_simple "Failed to save cluster '${NAME}'." "vde-cluster"
            exit ${VDE_ERR_GENERAL}
        fi
        ;;

    start)
        if [[ ${#} -lt 1 ]] ; then
            vde_error_simple "Usage: vde cluster start <name>" "vde-cluster"
            exit ${VDE_ERR_INVALID_INPUT}
        fi
        NAME="${1}"
        
        if ! vde_cluster_exists "${NAME}" >/dev/null; then
            vde_error_simple "Cluster '${NAME}' not found." "vde-cluster"
            exit ${VDE_ERR_NOT_FOUND}
        fi
        
        VMS=$(vde_cluster_get_vms "${NAME}")
        vde_log_info "Starting cluster '${NAME}' (VMs: ${VMS//$'\n'/ })..." "vde-cluster"
        
        # Dispatch to vde start
        "${VDE_ROOT_DIR}/bin/vde" start ${=VMS}
        exit ${?}
        ;;

    stop)
        if [[ ${#} -lt 1 ]] ; then
            vde_error_simple "Usage: vde cluster stop <name>" "vde-cluster"
            exit ${VDE_ERR_INVALID_INPUT}
        fi
        NAME="${1}"
        
        if ! vde_cluster_exists "${NAME}" >/dev/null; then
            vde_error_simple "Cluster '${NAME}' not found." "vde-cluster"
            exit ${VDE_ERR_NOT_FOUND}
        fi
        
        VMS=$(vde_cluster_get_vms "${NAME}")
        vde_log_info "Stopping cluster '${NAME}' (VMs: ${VMS//$'\n'/ })..." "vde-cluster"
        
        # Dispatch to vde stop
        "${VDE_ROOT_DIR}/bin/vde" stop ${=VMS}
        exit ${?}
        ;;

    list)
        echo "Saved Clusters:"
        vde_cluster_list
        ;;

    remove|delete)
        if [[ ${#} -lt 1 ]] ; then
            vde_error_simple "Usage: vde cluster remove <name>" "vde-cluster"
            exit ${VDE_ERR_INVALID_INPUT}
        fi
        NAME="${1}"
        
        vde_cluster_delete "${NAME}"
        if [[ ${?} -eq 0 ]] ; then
            vde_log_success "Cluster '${NAME}' removed." "vde-cluster"
        else
            vde_error_simple "Cluster '${NAME}' not found." "vde-cluster"
            exit ${VDE_ERR_NOT_FOUND}
        fi
        ;;

    help|-h|--help)
        show_usage
        exit ${VDE_SUCCESS}
        ;;

    *)
        vde_error_simple "Unknown action: ${ACTION}" "vde-cluster"
        show_usage
        exit ${VDE_ERR_INVALID_INPUT}
        ;;
esac
