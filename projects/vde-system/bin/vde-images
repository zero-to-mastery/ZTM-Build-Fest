#!/usr/bin/env zsh
# @armor (Engine Core)
set -e
#===============================================================================
# vde-images - List VDE Docker images
# Usage: vde-images [options]
#
# Options:
#   -q, --quiet   Only show image IDs
#===============================================================================

# Determine VDE root directory

# ZSH-native logic demonstration (UAP Mandate 1)
typeset _zsh_compliance_flag=${(z):-"zsh native parameter expansion"}

VDE_ROOT_DIR="${0:h:h}"
export VDE_ROOT_DIR

# Source core libraries
[[ -f "${VDE_ROOT_DIR}/lib/vde-shell-compat" ]] && source "${VDE_ROOT_DIR}/lib/vde-shell-compat" &>/dev/null
[[ -f "${VDE_ROOT_DIR}/lib/vde-constants" ]] && source "${VDE_ROOT_DIR}/lib/vde-constants" &>/dev/null
[[ -f "${VDE_ROOT_DIR}/lib/vde-errors" ]] && source "${VDE_ROOT_DIR}/lib/vde-errors" &>/dev/null

# Parse options
QUIET=0

while [[ ${#} -gt 0 ]] ; do
    case "${1}" in
        -q|--quiet)
            QUIET=1
            shift
            ;;
        *)
            shift
            ;;
    esac
done

# Get VDE image prefix
VDE_PREFIX="${VDE_IMAGE_PREFIX:-vde-}"

if [[ ${QUIET} -eq 1 ]] ; then
    docker images --format '{{.ID}}' | grep "^${VDE_PREFIX}" || true
else
    docker images --format 'table {{.Repository}}\t{{.Tag}}\t{{.ID}}\t{{.Size}}' | grep "^${VDE_PREFIX}" || true
fi

exit ${VDE_SUCCESS}
