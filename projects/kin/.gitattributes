# Golden protocol fixtures are exact bytes; never normalize them.
rust/fixtures/golden/** binary

# The files built into the home server's single executable
# (scripts/build-sea.mjs) keep LF endings in every checkout, including
# Windows with core.autocrlf, so an executable built on Windows is
# byte-identical to one built on Linux or macOS (#748). text=auto leaves
# binary files (images, the engine) alone.
server/** text=auto eol=lf
relay/ktun.mjs text eol=lf
web/** text=auto eol=lf
package.json text eol=lf
scripts/sea/main.cjs text eol=lf
