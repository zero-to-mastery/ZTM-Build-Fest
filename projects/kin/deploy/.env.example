# Copy to deploy/.env (never committed) and edit.

# The subdomain testers open, without https://. Its DNS A (and AAAA, if the
# server has IPv6) record must point at this server before the first start.
KIN_DOMAIN=kin.example.com

# A stranger who finds the URL can't fill the server with households.
KIN_MAX_HOUSEHOLDS=10

# Set to false once every tester's household exists.
KIN_ALLOW_NEW_HOUSEHOLDS=true
