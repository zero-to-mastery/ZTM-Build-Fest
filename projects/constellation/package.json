{
  "name": "constellation",
  "version": "5.2.0",
  "private": true,
  "bin": {
    "constellation": "src/cli.mjs"
  },
  "type": "module",
  "description": "Turn developer and project data into interactive constellations, embeds and README graphics.",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build:core": "node scripts/build-core.mjs",
    "build:rust": "node scripts/build-rust.mjs",
    "test:rust": "cargo test --locked --manifest-path rust/constellation-core/Cargo.toml",
    "benchmark:graph-quality": "node scripts/benchmark-graph-quality.mjs",
    "benchmark:story-composition": "node scripts/benchmark-story-composition.mjs",
    "benchmark:story-clarity": "node scripts/benchmark-story-clarity.mjs",
    "benchmark:evidence-navigation": "node scripts/benchmark-evidence-navigation.mjs",
    "benchmark:portfolio": "node scripts/benchmark-portfolio-artifact.mjs",
    "generate": "node src/cli.mjs",
    "test": "node --test --test-concurrency=1",
    "preview": "node scripts/serve.mjs",
    "generate:profile": "node scripts/generate-profile.mjs"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.64.1"
  }
}
