{
  "manifest_version": 3,
  "name": "Calm Reader",
  "version": "0.1.0",
  "description": "Reading profiles for dyslexia, ADHD and sensory calm, plus plain-language Simplify with your own API key.",
  "permissions": ["storage", "activeTab"],
  "optional_host_permissions": ["https://api.anthropic.com/*", "https://api.openai.com/*"],
  "background": { "service_worker": "background.js" },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Calm Reader",
    "default_icon": { "16": "icons/icon-16.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png" }
  },
  "options_ui": { "page": "options.html", "open_in_tab": true },
  "content_scripts": [
    { "matches": ["<all_urls>"], "js": ["content.js"], "run_at": "document_idle" }
  ],
  "web_accessible_resources": [
    { "resources": ["fonts/*.woff2"], "matches": ["<all_urls>"] }
  ],
  "icons": { "16": "icons/icon-16.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png" }
}
